/**
 * The gallery that zug's conformance check builds: every widget zug has,
 * in one window, as an application you can use. Every control keeps what
 * you do to it, and the line at the top right says what you last did.
 *
 * The switch at the top, or Gallery › Second Set in the menu bar, swaps
 * every widget to its second set of options, which is how the check
 * changes nearly every prop of every native view. The second set also
 * opens a second window, and going back puts the first set's values back.
 *
 *     zuri run examples/conformance.zu
 *
 * `zuri run tools/check_backend.zu` runs the checks themselves against
 * the gallery, and `check_backend()` in `zug.testing` does so from code.
 *
 * An application outside this repository writes `import zug { * }` and
 * `import zug.testing { gallery_app }`.
 */

import ..app { * }
import ..app.testing { gallery_app }

if __root__ == __file__ {
  run_app(gallery_app(ObservableValue(false)))
}
