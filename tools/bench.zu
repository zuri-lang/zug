/**
 * Times what applications ask of zug most: starting up, building and
 * rebuilding widget trees, laying them out, committing them to native
 * views, scrolling long lists, animating, and crossing into AppKit and
 * back.
 *
 *     zuri run tools/bench.zu
 *     zuri run tools/bench.zu --rounds 15 --json tmp/bench.json
 *     zuri run tools/bench.zu --only headless
 *
 * Timings from a busy machine say little, so it first waits, for up to
 * `--wait` minutes, until the one-minute load average is below
 * `--max-load`. Each measurement runs once to warm up and then `--rounds`
 * times, and the table gives the median and the fastest. On macOS the
 * AppKit measurements open windows for a few seconds.
 *
 * A frame is timed until zug has finished with AppKit: built, laid out
 * and committed to the native views. AppKit draws them on screen
 * afterwards, on its own schedule.
 */

import io
import os
import args
import ffi
import json
import zuri
import ..app { * }
import ..app.testing { WidgetTester }

var parser = args.Parser('bench', false)
parser.add_option(
  'rounds', 'How many times to time each measurement',
  { type: args.INT, value: 9 },
)
parser.add_option(
  'only', 'Run only the headless or the macos measurements',
  { type: args.STRING },
)
parser.add_option(
  'max-load', 'The load average to wait for before measuring',
  { type: args.NUMBER, value: 1.5 },
)
parser.add_option(
  'wait', 'Minutes to wait for the load to fall',
  { type: args.NUMBER, value: 30 },
)
parser.add_option(
  'json', 'A file to write the results to', { type: args.STRING },
)

var results = []

def record(group: string, name: string, unit: string, samples: list) {
  var sorted = samples.clone()
  sorted.sort(@(a, b) => a - b)
  var middle = sorted[(sorted.length() / 2).floor()]
  results.append({ group, name, unit, median: middle, best: sorted[0] })
}

# Times `fn` once to warm up and then `rounds` times, in seconds.
def timed(rounds: number, fn: function) {
  fn()
  var samples = []

  iter var i = 0; i < rounds; i++ {
    var start = time()
    fn()
    samples.append(time() - start)
  }

  return samples
}

def in_ms(samples: list) {
  return samples.map(@(s) => s * 1000)
}

# The one-minute load average, or nil where it cannot be read.
def load_average() {
  if os.platform == 'macos' {
    var out = os.exec('sysctl', '-n', 'vm.loadavg').output.trim()
    var parts = out.replace('{', '').replace('}', '').trim().split(' ')
    return parts[0].to_number()
  }

  if file('/proc/loadavg').exists() {
    return file('/proc/loadavg').read().split(' ')[0].to_number()
  }

  return nil
}

def wait_for_quiet(limit: number, minutes: number) {
  var deadline = time() + minutes * 60
  var load = load_average()

  while load != nil and load >= limit and time() < deadline {
    io.stderr.write('bench: load is ${load}, waiting for it to fall below ${limit}\n')
    os.sleep(30)
    load = load_average()
  }

  return load
}

# A list of rows, each a label and a button, in a scroll view. Its state
# can change nothing, one label or every label.
class Rows < StatefulWidget {
  var count = 0

  @new(count: number) {
    self.count = count
  }

  create_state() {
    return RowsState()
  }
}

var rows_state = nil

class RowsState < State {
  var marked = -1
  var version = 0

  init_state() {
    rows_state = self
  }

  build(context) {
    var rows = []

    iter var i = 0; i < self.widget.count; i++ {
      var label = i == self.marked ? 'Row ${i} *' : 'Row ${i}'
      rows.append(Row([
        Text(self.version == 0 ? label : '${label} v${self.version}'),
        Spacer(),
        Button('Open', { on_pressed: @{} }),
      ], { spacing: 8, key: ValueKey(i) }))
    }

    return ScrollView(Padding(
      EdgeInsets.all(8),
      Column(rows, { spacing: 4, align_items: AlignItems.STRETCH }),
    ))
  }
}

def touch_nothing() {
  rows_state.set_state()
}

def touch_one() {
  rows_state.set_state(@{
    rows_state.marked = (rows_state.marked + 1) % rows_state.widget.count
  })
}

def touch_all() {
  rows_state.set_state(@{
    rows_state.version++
  })
}

def long_list() {
  return ListView.builder(
    100000, @(context, index) => Row([
      Text('Item ${index}'), Spacer(), Text('${index * 3}'),
    ], { spacing: 8 }), { item_extent: 20 },
  )
}

# When a table last asked for a cell.
var last_cell = 0

def people_table(count: number) {
  return DataTable(
    [
      DataColumn('name', 'Name', { width: 160 }),
      DataColumn('n', 'Number', { width: 80 }),
    ], count, @(row, column) {
      last_cell = time()
      return column == 'name' ? 'Person ${row}' : '${row}'
    },
  )
}

def headless(rounds: number) {
  var group = 'headless'
  var size = Size(400, 600)

  record(group, 'mount 1,000 rows', 'ms', in_ms(timed(rounds, @{
    var t = WidgetTester()
    t.pump_widget(Rows(1000), { size })
    t.dispose()
  })))

  var t = WidgetTester().pump_widget(Rows(1000), { size })
  record(group, 'rebuild 1,000 rows, nothing changed', 'ms', in_ms(timed(
    rounds, @{
      touch_nothing()
      t.pump()
    },
  )))
  record(group, 'rebuild 1,000 rows, one label changed', 'ms', in_ms(timed(
    rounds, @{
      touch_one()
      t.pump()
    },
  )))
  record(group, 'rebuild 1,000 rows, every label changed', 'ms', in_ms(timed(
    rounds, @{
      touch_all()
      t.pump()
    },
  )))
  var wide = false
  record(group, 'lay 1,000 rows out again for a new width', 'ms', in_ms(timed(
    rounds, @{
      wide = !wide
      t.window().resize(Size(wide ? 480 : 400, 600))
      t.pump()
    },
  )))
  t.dispose()

  var value = ObservableValue(0)
  t = WidgetTester().pump_widget(Column([
    Observer(value, @(context) => Text('Value ${value.value()}')),
    Expanded(Rows(1000)),
  ], { align_items: AlignItems.STRETCH }), { size })
  record(group, 'rebuild one Observer beside 1,000 rows', 'ms', in_ms(timed(
    rounds, @{
      value.update(@(n) => n + 1)
      t.pump()
    },
  )))
  t.dispose()

  t = WidgetTester().pump_widget(long_list(), { size })
  var scroll = t.find_kind('scroll')[0]
  var y = 0
  record(group, 'scroll a 100,000-item list by five items', 'ms', in_ms(timed(
    rounds, @{
      y += 100
      scroll.fire('scrolled', { x: 0, y })
    },
  )))
  t.dispose()

  var open = ObservableValue(false)
  t = WidgetTester().pump_widget(Column([
    Observer(open, @(context) => AnimatedBox({
      duration: Duration.seconds(10),
      width: open.value() ? 300 : 100,
      height: 20,
      color: Color.RED,
    })),
    Expanded(Rows(1000)),
  ], { align_items: AlignItems.START }), { size })
  open.set(true)
  t.pump()
  record(group, 'animate a box beside 1,000 rows, per frame', 'ms', in_ms(timed(
    rounds, @{
      t.advance(1 / 60)
    },
  )))
  t.dispose()
}

# The AppKit measurements, run as steps on the event loop of one
# application, a short pause apart.
class TimedRuntime < Runtime {
  var durations = []
  var timing = false

  draw_frame() {
    var start = time()
    parent.draw_frame()

    if self.timing {
      self.durations.append(time() - start)
    }
  }
}

class Root < StatefulWidget {
  create_state() {
    return RootState()
  }
}

var root_state = nil

class RootState < State {
  var content

  init_state() {
    root_state = self
    self.content = Text('Ready')
  }

  show(widget) {
    self.set_state(@{
      self.content = widget
    })
  }

  build(context) {
    return self.content
  }
}

def objc_calls(rounds: number) {
  var here = os.dir_name(__file__)
  var objc = zuri.import_file(os.join_paths(
    here, '..', 'app', 'backends', 'macos', '_runtime.zu',
  ))
  var calls = 200000
  var object = objc.send(objc.send(objc.cls('NSObject'), 'alloc'), 'init')
  var hash = objc.typed(ffi.ulong, [])
  var selector = objc.sel('hash')
  record('macos', 'call an Objective-C method', 'ns', timed(rounds, @{
    iter var i = 0; i < calls; i++ {
      hash(object, selector)
    }
  }).map(@(s) => s * 1000000000 / calls))

  var target = objc.define_class('ZugBenchTarget', 'NSObject', {
    'zugBenchValue': ['q@:', ffi.long, [], @(this) => 42, 0],
  })
  var instance = objc.send(objc.send(target, 'alloc'), 'init')
  var value = objc.typed(ffi.long, [])
  var value_selector = objc.sel('zugBenchValue')
  record(
    'macos', 'call Zuri from Objective-C and return', 'ns', timed(rounds, @{
      iter var i = 0; i < calls / 4; i++ {
        value(instance, value_selector)
      }
    }).map(@(s) => s * 1000000000 / (calls / 4)),
  )
}

def macos(rounds: number) {
  objc_calls(rounds)
  var objc = zuri.import_file(os.join_paths(
    os.dir_name(__file__), '..', 'app', 'backends', 'macos', '_runtime.zu',
  ))

  var backend = create_backend('macos')
  var runtime = TimedRuntime(backend)
  var group = 'macos'
  var steps = []
  var frame = @{
    runtime.draw_frame()
  }

  # Has AppKit draw the window now rather than when the loop next waits,
  # which is when a table asks for the cells it shows.
  var draw = @{
    objc.send_void(runtime.windows()[0].view.native, 'displayIfNeeded')
  }

  # Times showing `widget`, drawn on screen too when `drawn`, and then
  # taking it away again, as separate samples.
  var show_and_remove = @(widget_for, drawn) {
    var shown = []
    var removed = []

    iter var i = 0; i <= rounds; i++ {
      var start = time()
      root_state.show(widget_for())
      frame()

      if drawn {
        draw()
      }

      var middle = time()
      root_state.show(Text('Empty'))
      frame()

      if i > 0 {
        shown.append(middle - start)
        removed.append(time() - middle)
      }
    }

    return [shown, removed]
  }

  steps.append(@{
    var times = show_and_remove(@() => Rows(1000), false)
    record(group, 'mount 1,000 rows, 2,000 native views', 'ms', in_ms(times[0]))
    record(group, 'tear down 1,000 rows', 'ms', in_ms(times[1]))
    times = show_and_remove(@() => Rows(1000), true)
    record(group, 'mount 1,000 rows and draw them', 'ms', in_ms(times[0]))
  })
  steps.append(@{
    root_state.show(Rows(1000))
    frame()
    record(group, 'rebuild 1,000 rows, nothing changed', 'ms', in_ms(timed(
      rounds, @{
        touch_nothing()
        frame()
      },
    )))
    record(group, 'rebuild 1,000 rows, one label changed', 'ms', in_ms(timed(
      rounds, @{
        touch_one()
        frame()
      },
    )))
    record(group, 'rebuild 1,000 rows, every label changed', 'ms', in_ms(timed(
      rounds, @{
        touch_all()
        frame()
      },
    )))
    var wide = false
    var window = runtime.windows()[0].view
    record(group, 'resize the window of 1,000 rows', 'ms', in_ms(timed(
      rounds, @{
        wide = !wide
        window.set_content_size_to(Size(wide ? 480 : 400, 600))
        frame()
      },
    )))
    window.set_content_size_to(Size(400, 600))
  })
  # A table asks for the cells it shows only once the event loop runs, so
  # each round starts in one step and is read in the next, from the time
  # the last cell was asked for.
  var shown = []
  var reloaded = []
  var started = 0

  iter var i = 0; i <= rounds; i++ {
    var round = i
    steps.append(@{
      root_state.show(Text('Empty'))
      frame()
      started = time()
      root_state.show(people_table(100000))
      frame()
    })
    steps.append(@{
      if round > 0 {
        shown.append(last_cell - started)
      }

      started = time()
      root_state.show(people_table(100000))
      frame()
    })
    steps.append(@{
      if round > 0 {
        reloaded.append(last_cell - started)
      }
    })
  }

  steps.append(@{
    record(
      group, 'show a table of 100,000 rows until its cells are in', 'ms',
      in_ms(shown),
    )
    record(
      group, 'reload a table of 100,000 rows until its cells are in', 'ms',
      in_ms(reloaded),
    )
  })

  # A one-second animation of a box, alone and then beside 1,000 rows. The
  # step that starts one is followed by a pause longer than it runs.
  var pauses = {}

  for beside in [false, true] {
    var open = ObservableValue(false)
    var with_rows = beside
    var label = with_rows ? 'beside 1,000 rows' : 'alone'
    steps.append(@{
      var children = [Observer(open, @(context) => AnimatedBox({
        duration: Duration.seconds(1),
        curve: Curve.LINEAR,
        width: open.value() ? 300 : 100,
        height: 20,
        color: Color.system('accent'),
      }))]

      if with_rows {
        children.append(Expanded(Rows(1000)))
      }

      root_state.show(Column(children, { align_items: AlignItems.START }))
      frame()
      draw()
      runtime.durations = []
      runtime.timing = true
      open.set(true)
    })
    pauses[steps.length() - 1] = 1.3
    steps.append(@{
      runtime.timing = false
      var frames = runtime.durations

      if !frames.is_empty() {
        record(group, 'animate a box ${label}, per frame', 'ms', in_ms(frames))
      }

      record(
        group, 'frames in a second of animation, box ${label}',
        'frames', [frames.length()],
      )
    })
  }

  steps.append(@{
    record(
      group, 'the display refreshing at', 'Hz',
      [(1 / backend.frame_interval()).round()],
    )
  })

  # Each step starts the next once it is done, so a slow step never
  # leaves the next to run straight after it.
  var index = 0
  var next = nil
  next = @{
    if steps.is_empty() {
      runtime.quit()
      return
    }

    var step = steps.remove_at(0)
    var pause = pauses.get(index, 0.2)
    index++

    catch {
      step()
    } as error {
      io.stderr.write('bench: a step failed: ${typeof(error)}: ${error.message}\n')
      steps = []
    }

    backend.start_timer(pause, false, next)
  }
  backend.start_timer(0.5, false, next)

  runtime.run(App({
    title: 'zug bench',
    windows: [Window('zug bench', Root(), { size: Size(400, 600) })],
  }))
}

def startup(rounds: number) {
  var probe = os.join_paths(os.dir_name(__file__), 'startup_probe.zu')
  var imported = []
  var drawn = []

  def once() {
    var start = time()
    var out = os.exec(os.exe_path, 'run', probe).output

    for line in out.lines() {
      var parts = line.split(' ')

      if parts[0] == 'imported' {
        imported.append(parts[1].to_number() - start)
      } else if parts[0] == 'drawn' {
        drawn.append(parts[1].to_number() - start)
      }
    }
  }

  once()
  imported = []
  drawn = []

  iter var i = 0; i < rounds; i++ {
    once()
  }

  record('macos', 'start zuri and import zug', 'ms', in_ms(imported))
  record(
    'macos', 'start an application until its first frame', 'ms', in_ms(drawn),
  )
}

def show_results(load) {
  var machine = os.platform == 'macos'
    ? os.exec('sysctl', '-n', 'machdep.cpu.brand_string').output.trim()
    : os.platform
  echo 'zug benchmarks on ${machine}, ${os.exec(os.exe_path, "--version").output.lines()[0]}, load ${load}'
  echo ''

  for result in results {
    var unit = result.unit
    var median = _format(result.median, unit)
    var best = _format(result.best, unit)
    echo '${result.group.rpad(9)}${result.name.rpad(58)}${median.lpad(12)}${best.lpad(12)}'
  }
}

def _format(value: number, unit: string) {
  if unit == 'frames' or unit == 'Hz' {
    return unit == 'Hz' ? '${value} Hz' : '${value}'
  }

  var digits = value >= 100 ? 0 : value >= 10 ? 1 : 2
  return '${value.fixed(digits)} ${unit}'
}

if __root__ == __file__ {
  var parsed = parser.parse()
  var o = parsed.options
  var load = wait_for_quiet(o['max-load'], o.wait)
  var only = o.get('only')

  if only == nil or only == 'headless' {
    headless(o.rounds)
  }

  if os.platform == 'macos' and (only == nil or only == 'macos') {
    startup(o.rounds)
    macos(o.rounds)
  }

  show_results(load)

  if o.contains('json') {
    file(o.json, 'w').write(json.encode({ load, results }))
  }
}
