/**
 * Easing curves: how an animation's progress turns into movement.
 */

/**
 * An easing curve. It takes linear progress from 0 to 1 and returns how
 * far along the movement is, which starts at 0 and ends at 1 but may
 * pass beyond them on the way, as `BACK_OUT` does.
 *
 * Make one from a function, or use the standard ones:
 *
 * ```zuri
 * import zug { Curve }
 *
 * var settle = Curve.EASE_OUT
 * var custom = Curve.cubic(0.2, 0, 0, 1)
 * var squared = Curve(@(t) => t * t)
 * echo settle.transform(0.5)
 * ```
 *
 * @printable
 */
class Curve {

  /**
   * How the curve prints, such as `Curve.EASE_OUT`.
   *
   * @type string
   */
  var name = 'Curve'

  var _function

  /**
   * Even speed from start to finish.
   *
   * @type Curve
   */
  static var LINEAR = nil

  /**
   * The gentle default of the web: a quick start that eases into the end.
   *
   * @type Curve
   */
  static var EASE = nil

  /**
   * Starts slowly and speeds up, for things leaving.
   *
   * @type Curve
   */
  static var EASE_IN = nil

  /**
   * Starts quickly and slows down, for things arriving.
   *
   * @type Curve
   */
  static var EASE_OUT = nil

  /**
   * Slow at both ends, for things moving from one place to another.
   *
   * @type Curve
   */
  static var EASE_IN_OUT = nil

  /**
   * Pulls back a little before it goes.
   *
   * @type Curve
   */
  static var BACK_IN = nil

  /**
   * Overshoots the end a little and settles back onto it.
   *
   * @type Curve
   */
  static var BACK_OUT = nil

  /**
   * Bounces against the end like a dropped ball.
   *
   * @type Curve
   */
  static var BOUNCE_OUT = nil

  /**
   * @param function transform: called with progress strictly between 0
   *    and 1; returns the movement.
   * @param ?string name: how the curve prints.
   * @constructor
   */
  @new(transform: function, name: ?string) {
    self._function = transform
    self.name = name == nil ? 'Curve' : name
  }

  /**
   * The movement at progress `t`. Progress at or below 0 gives 0, and at
   * or above 1 gives 1, so every curve starts and ends in place.
   *
   * @param number t
   * @returns number
   */
  transform(t: number) {
    if t <= 0 {
      return 0
    }

    if t >= 1 {
      return 1
    }

    return self._function(t)
  }

  /**
   * The same curve played backwards and upside down, so an ease-in
   * becomes an ease-out.
   *
   * @returns Curve
   */
  flipped() {
    var original = self
    return Curve(
      @(t) => 1 - original.transform(1 - t), '${self.name}.flipped()',
    )
  }

  /**
   * A cubic Bézier curve from (0, 0) to (1, 1) with control points (x1,
   * y1) and (x2, y2), as CSS `cubic-bezier()` takes them.
   *
   * @param number x1: from 0 to 1.
   * @param number y1
   * @param number x2: from 0 to 1.
   * @param number y2
   * @returns Curve
   * @throws ValueError When x1 or x2 is outside 0 to 1
   */
  static cubic(x1: number, y1: number, x2: number, y2: number) {
    if !(x1 >= 0 and x1 <= 1 and x2 >= 0 and x2 <= 1) {
      raise ValueError('the x of a cubic curve control point must be from 0 to 1, got ${x1} and ${x2}')
    }

    return Curve(
      _cubic(x1, y1, x2, y2), 'Curve.cubic(${x1}, ${y1}, ${x2}, ${y2})',
    )
  }

  /**
   * Jumps in `count` equal steps, holding each until the next, as a
   * ticking clock moves.
   *
   * @param number count: a whole number, at least 1.
   * @returns Curve
   * @throws ValueError When count is not a whole number of at least 1
   */
  static steps(count: number) {
    if !is_int(count) or count < 1 {
      raise ValueError('a stepped curve needs a whole number of steps, at least 1, got ${count}')
    }

    return Curve(@(t) => (t * count).floor() / count, 'Curve.steps(${count})')
  }

  /**
   * Holds at 0 until `start`, moves along `curve` until `end`, and holds
   * at 1 after it. Several of these on one animation make a staggered
   * sequence.
   *
   * @param number start: from 0 to 1.
   * @param number end: from `start` to 1.
   * @param ?Curve curve: `LINEAR` when left out.
   * @returns Curve
   * @throws ValueError When start and end are not in order within 0 to 1
   */
  static interval(start: number, end: number, curve: ?Curve) {
    if !(start >= 0 and end <= 1 and start < end) {
      raise ValueError('an interval must run forwards within 0 to 1, got ${start} to ${end}')
    }

    var inner = curve == nil ? Curve.LINEAR : curve
    return Curve(
      @(t) {
        if t <= start {
          return 0
        }

        if t >= end {
          return 1
        }

        return inner.transform((t - start) / (end - start))
      }, 'Curve.interval(${start}, ${end}, ${inner.name})',
    )
  }

  @to_string() {
    return self.name
  }
}

# A cubic Bézier easing curve, solved for x the way browsers solve it:
# Newton's method, falling back to bisection where the slope is too flat.
class _Bezier {
  var ax = 0
  var bx = 0
  var cx = 0
  var ay = 0
  var by = 0
  var cy = 0

  @new(x1: number, y1: number, x2: number, y2: number) {
    self.cx = 3 * x1
    self.bx = 3 * (x2 - x1) - self.cx
    self.ax = 1 - self.cx - self.bx
    self.cy = 3 * y1
    self.by = 3 * (y2 - y1) - self.cy
    self.ay = 1 - self.cy - self.by
  }

  at(x: number) {
    var t = self._solve(x)
    return ((self.ay * t + self.by) * t + self.cy) * t
  }

  _x(t: number) {
    return ((self.ax * t + self.bx) * t + self.cx) * t
  }

  _slope(t: number) {
    return (3 * self.ax * t + 2 * self.bx) * t + self.cx
  }

  _solve(x: number) {
    var t = x

    iter var i = 0; i < 8; i++ {
      var error = self._x(t) - x

      if error.abs() < 0.0000001 {
        return t
      }

      var slope = self._slope(t)

      if slope.abs() < 0.000001 {
        break
      }

      t -= error / slope
    }

    var low = 0
    var high = 1
    t = x

    while low < high {
      var value = self._x(t)

      if (value - x).abs() < 0.0000001 {
        return t
      }

      if x > value {
        low = t
      } else {
        high = t
      }

      t = (high - low) / 2 + low

      if high - low < 0.0000001 {
        return t
      }
    }

    return t
  }
}

def _cubic(x1: number, y1: number, x2: number, y2: number) {
  var bezier = _Bezier(x1, y1, x2, y2)
  return @(t) => bezier.at(t)
}

def _bounce(t: number) {
  if t < 1 / 2.75 {
    return 7.5625 * t * t
  }

  if t < 2 / 2.75 {
    var u = t - 1.5 / 2.75
    return 7.5625 * u * u + 0.75
  }

  if t < 2.5 / 2.75 {
    var u = t - 2.25 / 2.75
    return 7.5625 * u * u + 0.9375
  }

  var u = t - 2.625 / 2.75
  return 7.5625 * u * u + 0.984375
}

Curve.LINEAR = Curve(@(t) => t, 'Curve.LINEAR')
Curve.EASE = Curve(_cubic(0.25, 0.1, 0.25, 1), 'Curve.EASE')
Curve.EASE_IN = Curve(_cubic(0.42, 0, 1, 1), 'Curve.EASE_IN')
Curve.EASE_OUT = Curve(_cubic(0, 0, 0.58, 1), 'Curve.EASE_OUT')
Curve.EASE_IN_OUT = Curve(_cubic(0.42, 0, 0.58, 1), 'Curve.EASE_IN_OUT')
Curve.BACK_IN = Curve(_cubic(0.6, -0.28, 0.735, 0.045), 'Curve.BACK_IN')
Curve.BACK_OUT = Curve(_cubic(0.175, 0.885, 0.32, 1.275), 'Curve.BACK_OUT')
Curve.BOUNCE_OUT = Curve(_bounce, 'Curve.BOUNCE_OUT')
