/**
 * Children laid out in runs that wrap onto a new line when full.
 */

import ..foundation { Point, Size, Constraints, INFINITY }
import .object { RenderObject }

/**
 * Lays its children along `axis` in runs, starting a new run when the
 * next child would not fit. `justify` spreads the children within a run,
 * `run_justify` spreads the runs, and `align_items` places each child
 * across its run.
 */
class RenderWrap < RenderObject {

  /**
   * @type string
   */
  var axis = 'horizontal'

  /**
   * The gap between children in a run.
   *
   * @type number
   */
  var spacing = 0

  /**
   * The gap between runs.
   *
   * @type number
   */
  var run_spacing = 0

  /**
   * @type string
   */
  var justify = 'start'

  /**
   * @type string
   */
  var run_justify = 'start'

  /**
   * `start`, `end` or `center`.
   *
   * @type string
   */
  var align_items = 'start'

  /**
   * @param string axis
   * @constructor
   */
  @new(axis: string) {
    parent()
    self.axis = axis
  }

  /**
   * @param string axis
   * @param number spacing
   * @param number run_spacing
   * @param string justify
   * @param string run_justify
   * @param string align_items
   */
  configure(
    axis: string, spacing: number, run_spacing: number, justify: string,
    run_justify: string, align_items: string,
  ) {
    if axis != self.axis
      or spacing != self.spacing
      or run_spacing != self.run_spacing
      or justify != self.justify
      or run_justify != self.run_justify
      or align_items != self.align_items {
      self.axis = axis
      self.spacing = spacing
      self.run_spacing = run_spacing
      self.justify = justify
      self.run_justify = run_justify
      self.align_items = align_items
      self.mark_needs_layout()
    }
  }

  _main(size) {
    return self.axis == 'horizontal' ? size.width : size.height
  }

  _cross(size) {
    return self.axis == 'horizontal' ? size.height : size.width
  }

  # Lays the children out and groups them into runs, each a dictionary of
  # its children, main extent and cross extent.
  _runs(max_main: number) {
    var horizontal = self.axis == 'horizontal'
    var c = self.constraints
    var child_constraints = horizontal
      ? Constraints(0, c.max_width, 0, INFINITY)
      : Constraints(0, INFINITY, 0, c.max_height)
    var runs = []
    var current = { children: [], main: 0, cross: 0 }

    for child in self.children {
      child.layout(child_constraints, true)
      var main = self._main(child.size)
      var cross = self._cross(child.size)
      var needed = current.children.is_empty()
        ? main
        : current.main + self.spacing + main

      if !current.children.is_empty() and needed > max_main {
        runs.append(current)
        current = { children: [], main: 0, cross: 0 }
        needed = main
      }

      current.children.append(child)
      current['main'] = needed
      current['cross'] = current.cross.max(cross)
    }

    if !current.children.is_empty() {
      runs.append(current)
    }

    return runs
  }

  _spread(mode: string, remaining: number, count: number, gap: number) {
    var leading = 0
    var between = gap

    using mode {
      when 'end' {
        leading = remaining
      }
      when 'center' {
        leading = remaining / 2
      }
      when 'space_between' {
        between += count > 1 ? remaining / (count - 1) : 0
      }
      when 'space_around' {
        var share = count > 0 ? remaining / count : 0
        between += share
        leading = share / 2
      }
      when 'space_evenly' {
        var share = remaining / (count + 1)
        between += share
        leading = share
      }
    }

    return [leading, between]
  }

  perform_layout() {
    var horizontal = self.axis == 'horizontal'
    var c = self.constraints
    var max_main = horizontal ? c.max_width : c.max_height
    var runs = self._runs(max_main)
    var content_main = 0
    var content_cross = 0

    for run in runs {
      content_main = content_main.max(run.main)
      content_cross += run.cross
    }

    if runs.length() > 1 {
      content_cross += self.run_spacing * (runs.length() - 1)
    }

    var wanted = horizontal
      ? Size(content_main, content_cross)
      : Size(content_cross, content_main)
    self.size = c.constrain(wanted)
    var main_size = self._main(self.size)
    var cross_size = self._cross(self.size)
    var run_spread = self._spread(
      self.run_justify, (cross_size - content_cross).max(0), runs.length(),
      self.run_spacing,
    )
    var cross_position = run_spread[0]

    for run in runs {
      var count = run.children.length()
      var spread = self._spread(
        self.justify, (main_size - run.main).max(0), count, self.spacing,
      )
      var main_position = spread[0]

      for child in run.children {
        var offset = 0

        if self.align_items == 'end' {
          offset = run.cross - self._cross(child.size)
        } else if self.align_items == 'center' {
          offset = (run.cross - self._cross(child.size)) / 2
        }

        if horizontal {
          self.place_child(child, Point(main_position, cross_position + offset))
        } else {
          self.place_child(child, Point(cross_position + offset, main_position))
        }

        main_position += self._main(child.size) + spread[1]
      }

      cross_position += run.cross + run_spread[1]
    }
  }

  compute_min_intrinsic_width(height: number) {
    var best = 0

    for child in self.children {
      best = best.max(child.min_intrinsic_width(INFINITY))
    }

    return best
  }

  compute_max_intrinsic_width(height: number) {
    var total = 0

    for child in self.children {
      total += child.max_intrinsic_width(INFINITY)
    }

    return total
      + (self.children.length() > 1
        ? self.spacing * (self.children.length() - 1)
        : 0)
  }
}
