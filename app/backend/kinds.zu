/**
 * The kinds of native view, with the props each takes and the events each
 * reports. This is the specification a backend implements: `zug`'s
 * widgets only ever send these props and listen for these events.
 *
 * Each prop has a type, a default and whether changing it can change the
 * view's size. Each event may name the prop it changes, which makes that
 * prop controlled: what the widget declares is what the view shows, so a
 * user's change that the application does not accept is undone.
 *
 * Sizing says how a view of the kind fills the space it is offered on
 * each axis: `intrinsic` takes the size `measure()` gives, and `fill`
 * takes all of a bounded axis, falling back to `measure()` when the axis
 * is unbounded.
 */

import ..foundation { Color, Size, Point, check_options }
import ..painting { Border, Shadow }

/**
 * One prop of a kind.
 */
class PropSpec {

  /**
   * What values it takes, as `check_options()` describes types.
   *
   * @type any
   */
  var type

  /**
   * The value a view starts with when the prop is not given.
   *
   * @type any
   */
  var initial

  /**
   * Whether changing it can change the view's size.
   *
   * @type bool
   */
  var layout = true

  /**
   * @param any type
   * @param any initial
   * @param bool layout
   * @constructor
   */
  @new(type, initial, layout: bool) {
    self.type = type
    self.initial = initial
    self.layout = layout
  }
}

/**
 * One kind of native view.
 */
class KindSpec {

  /**
   * @type string
   */
  var name

  /**
   * Prop names to `PropSpec`s.
   *
   * @type dict
   */
  var props = {}

  /**
   * Event names to the prop each controls, or `nil`.
   *
   * @type dict
   */
  var events = {}

  /**
   * How the view fills the width it is offered: `intrinsic` or `fill`.
   *
   * @type string
   */
  var width = 'intrinsic'

  /**
   * How the view fills the height it is offered.
   *
   * @type string
   */
  var height = 'intrinsic'

  /**
   * Whether views of this kind hold child views.
   *
   * @type bool
   */
  var container = false

  /**
   * @param string name
   * @constructor
   */
  @new(name: string) {
    self.name = name
  }

  /**
   * Every prop's starting value.
   *
   * @returns dict
   */
  initial_props() {
    var values = {}

    for name, prop in self.props {
      values[name] = prop.initial
    }

    return values
  }

  /**
   * Whether changing `prop` can change the view's size. Unknown props are
   * assumed to.
   *
   * @param string prop
   * @returns bool
   */
  affects_layout(prop: string) {
    var spec = self.props.get(prop)
    return spec == nil or spec.layout
  }

  /**
   * The prop `event` changes, or `nil`.
   *
   * @param string event
   * @returns ?string
   */
  controlled_by(event: string) {
    return self.events.get(event)
  }
}

var _kinds = {}

# Props every view kind takes. None of them changes a view's size.
var _COMMON = {
  tooltip: ['string', nil, false],
  hidden: ['bool', false, false],
  accessibility_label: ['string', nil, false],
  accessibility_identifier: ['string', nil, false],
}

/**
 * Adds a kind of view. Applications only need this for a kind of their
 * own, backed by a backend that implements it.
 *
 * @param string name
 * @param dict spec: `props`, prop names to `[type, initial, layout]`;
 *    `events`, event names to the prop each controls or `nil`; and
 *    optionally `width` and `height` (`intrinsic` or `fill`) and
 *    `container` (a bool).
 * @returns KindSpec
 * @throws ValueError When the kind already exists
 */
def define_kind(name: string, spec: dict) {
  if _kinds.contains(name) {
    raise ValueError("the view kind '${name}' is already defined")
  }

  var o = check_options(
    spec, 'define_kind',
    {
      props: 'dict',
      events: 'dict',
      width: 'string',
      height: 'string',
      container: 'bool',
    },
  )
  var kind = KindSpec(name)

  for prop, entry in _COMMON {
    kind.props[prop] = PropSpec(entry[0], entry[1], entry[2])
  }

  for prop, entry in o.get('props', {}) {
    kind.props[prop] = PropSpec(
      entry[0], entry[1], entry.length() > 2 ? entry[2] : true,
    )
  }

  kind.events = o.get('events', {})
  kind.width = o.get('width', 'intrinsic')
  kind.height = o.get('height', 'intrinsic')
  kind.container = o.get('container', false)

  for axis in [kind.width, kind.height] {
    if axis != 'intrinsic' and axis != 'fill' {
      raise ValueError("sizing must be 'intrinsic' or 'fill', got '${axis}'")
    }
  }

  _kinds[name] = kind
  return kind
}

/**
 * The kind called `name`.
 *
 * @param string name
 * @returns KindSpec
 * @throws ValueError When there is no such kind
 */
def kind_spec(name: string) {
  var kind = _kinds.get(name)

  if kind == nil {
    raise ValueError("there is no view kind '${name}'")
  }

  return kind
}

/**
 * The names of every kind, in the order they were defined.
 *
 * @returns list
 */
def kind_names() {
  return _kinds.keys()
}

define_kind('window', {
  props: {
    title: ['string', '', false],
    size: [Size, Size(480, 320), false],
    min_size: [Size, nil, false],
    max_size: [Size, nil, false],
    resizable: ['bool', true, false],
    closable: ['bool', true, false],
    minimizable: ['bool', true, false],
    title_bar: ['string', 'normal', false],
    background: [Color, nil, false],
    visible: ['bool', true, false],
    position: [Point, nil, false],
    floating: ['bool', false, false],
  },
  events: {
    close_requested: nil,
    closed: nil,
    resized: nil,
    focus_changed: nil,
    key: nil,
  },
  container: true,
})

