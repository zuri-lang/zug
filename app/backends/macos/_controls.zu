/**
 * Controls that choose a value, indicators, separators, group boxes and
 * images.
 */

import ffi
import .. ..foundation { Size, Color, EdgeInsets, Constraints }
import ._runtime {
  cls,
  sel,
  send,
  send_id,
  send_void,
  send_void_id,
  send_void_bool,
  send_void_int,
  send_void_uint,
  send_void_double,
  send_void_rect,
  send_int,
  send_uint,
  send_double,
  send_bool,
  send_size,
  send_rect,
  typed,
  ns_string,
  retain,
  release,
  rect,
  create_with_frame,
  CGRect,
  CGSize,
  send_void_size,
  from_ns_array,
}
import ._classes { register, unregister, shared_target }
import ._cocoa { ns_color }
import ._views { MacView, control_size }

var _set_action = typed(ffi.void, [ffi.ptr])

# Points a control's action at the shared target.
def _wire(control) {
  send_void_id(control, 'setTarget:', shared_target())
  _set_action(control, sel('setAction:'), sel('zugAction:'))
}

def _state_of(value) {
  if value == nil {
    return -1
  }

  return value ? 1 : 0
}

/**
 * A checkbox.
 */
class MacCheckbox < MacView {

  @new(backend, props: dict, dispatch: function) {
    var button = create_with_frame('NSButton', nil)

    # NSButtonTypeSwitch.
    send_void_uint(button, 'setButtonType:', 3)
    _wire(button)
    self.setup(backend, 'checkbox', button, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'title' {
        send_void_id(self.native, 'setTitle:', ns_string(value))
      }
      when 'value' {
        send_void_int(self.native, 'setState:', _state_of(value))
      }
      when 'tristate' {
        # A mixed state set before mixed states were allowed reads as on,
        # so the state is set again.
        send_void_bool(self.native, 'setAllowsMixedState:', value == true)
        send_void_int(
          self.native,
          'setState:',
          _state_of(self.props.get('value')),
        )
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  on_action() {
    var state = send_int(self.native, 'state')
    self.fire('changed', { value: state == -1 ? nil : state == 1 })
  }
}

/**
 * A radio button. It sits alone in a container of its own, because AppKit
 * groups radio buttons that share a superview and switches them off
 * itself, and zug decides which one is on.
 */
class MacRadio < MacView {
  var button

  @new(backend, props: dict, dispatch: function) {
    var holder = create_with_frame('ZugView', nil)
    self.button = create_with_frame('NSButton', nil)

    # NSButtonTypeRadio, filling the holder as it is resized.
    send_void_uint(self.button, 'setButtonType:', 4)
    send_void_uint(self.button, 'setAutoresizingMask:', 18)
    _wire(self.button)
    send_void_id(holder, 'addSubview:', self.button)
    register(self.button, self)
    self.setup(backend, 'radio', holder, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'title' {
        send_void_id(self.button, 'setTitle:', ns_string(value))
      }
      when 'selected' {
        send_void_int(self.button, 'setState:', value ? 1 : 0)
      }
      when 'enabled' {
        send_void_bool(self.button, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.button, 'setControlSize:', control_size(value))
      }
    }
  }

  set_frame(frame) {
    parent.set_frame(frame)
    send_void_rect(
      self.button,
      'setFrame:',
      rect(0, 0, frame.width, frame.height),
    )
  }

  measure(constraints: Constraints) {
    var size = send_size(self.button, 'fittingSize')
    return Size(size.width, size.height)
  }

  baseline() {
    var offset = send_double(self.button, 'firstBaselineOffsetFromTop')
    return offset > 0 ? offset : nil
  }

  focus_target() {
    return self.button
  }

  before_destroy() {
    unregister(self.button)
    release(self.button)
  }

  on_action() {
    self.fire('changed', { selected: send_int(self.button, 'state') == 1 })
  }
}

/**
 * An on and off switch.
 */
class MacSwitch < MacView {

  @new(backend, props: dict, dispatch: function) {
    var control = create_with_frame('NSSwitch', nil)
    _wire(control)
    self.setup(backend, 'switch', control, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        send_void_int(self.native, 'setState:', value ? 1 : 0)
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  on_action() {
    self.fire('changed', { value: send_int(self.native, 'state') == 1 })
  }
}

/**
 * A slider.
 */
class MacSlider < MacView {

  @new(backend, props: dict, dispatch: function) {
    var control = create_with_frame('NSSlider', nil)
    send_void_bool(control, 'setContinuous:', true)
    _wire(control)
    self.setup(backend, 'slider', control, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        send_void_double(self.native, 'setDoubleValue:', value)
      }
      when 'min' {
        send_void_double(self.native, 'setMinValue:', value)
      }
      when 'max' {
        send_void_double(self.native, 'setMaxValue:', value)
      }
      when 'divisions' {
        send_void_int(
          self.native,
          'setNumberOfTickMarks:',
          value > 0 ? value + 1 : 0,
        )
        send_void_bool(self.native, 'setAllowsTickMarkValuesOnly:', value > 0)
      }
      when 'vertical' {
        send_void_bool(self.native, 'setVertical:', value == true)
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  measure(constraints: Constraints) {
    var size = send_size(self.native, 'fittingSize')

    if self.props.get('vertical') {
      return Size(size.width, size.height.max(160))
    }

    return Size(size.width.max(160), size.height)
  }

  on_action() {
    var value = send_double(self.native, 'doubleValue')
    self.fire('changed', { value })
    var event = send(
      send(cls('NSApplication'), 'sharedApplication'),
      'currentEvent',
    )

    # NSEventTypeLeftMouseUp ends a drag; a key press changes the value in
    # one step.
    var type = event == nil ? 0 : send_uint(event, 'type')

    if type != 6 and type != 1 {
      self.fire('change_end', { value })
    }
  }
}

/**
 * Up and down arrows.
 */
class MacStepper < MacView {

  @new(backend, props: dict, dispatch: function) {
    var control = create_with_frame('NSStepper', nil)
    send_void_bool(control, 'setAutorepeat:', true)
    _wire(control)
    self.setup(backend, 'stepper', control, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        send_void_double(self.native, 'setDoubleValue:', value)
      }
      when 'min' {
        send_void_double(self.native, 'setMinValue:', value)
      }
      when 'max' {
        send_void_double(self.native, 'setMaxValue:', value)
      }
      when 'step' {
        send_void_double(self.native, 'setIncrement:', value)
      }
      when 'wraps' {
        send_void_bool(self.native, 'setValueWraps:', value == true)
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  on_action() {
    self.fire('changed', { value: send_double(self.native, 'doubleValue') })
  }
}

/**
 * A progress bar or spinner.
 */
class MacProgress < MacView {
  var spinning = false

  @new(backend, kind: string, props: dict, dispatch: function) {
    var indicator = create_with_frame('NSProgressIndicator', nil)
    self.spinning = kind == 'spinner'

    # NSProgressIndicatorStyleBar 0, Spinning 1.
    send_void_uint(indicator, 'setStyle:', self.spinning ? 1 : 0)

    if self.spinning {
      send_void_bool(indicator, 'setIndeterminate:', true)
      send_void_bool(indicator, 'setDisplayedWhenStopped:', false)
    }

    self.setup(backend, kind, indicator, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        send_void_bool(self.native, 'setIndeterminate:', value == nil)

        if value == nil {
          send_void_id(self.native, 'startAnimation:', nil)
        } else {
          send_void_id(self.native, 'stopAnimation:', nil)
          send_void_double(self.native, 'setDoubleValue:', value)
        }
      }
      when 'min' {
        send_void_double(self.native, 'setMinValue:', value)
      }
      when 'max' {
        send_void_double(self.native, 'setMaxValue:', value)
      }
      when 'animating' {
        send_void_id(
          self.native,
          value ? 'startAnimation:' : 'stopAnimation:',
          nil,
        )
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  measure(constraints: Constraints) {
    if self.spinning {
      var size = self.props.get('control_size', 'regular')
      var extent = size == 'small' or size == 'mini' ? 16 : 32
      return Size(extent, extent)
    }

    return Size(160, 20)
  }

  before_destroy() {
    send_void_id(self.native, 'stopAnimation:', nil)
  }
}

# NSSegmentSwitchTracking values for each SegmentMode.
var _TRACKING = { one: 0, any: 1, momentary: 2 }

/**
 * A segmented control.
 */
class MacSegmented < MacView {

  @new(backend, props: dict, dispatch: function) {
    var control = create_with_frame('NSSegmentedControl', nil)
    _wire(control)
    self.setup(backend, 'segmented', control, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'segments' {
        var set_label = typed(ffi.void, [ffi.ptr, ffi.long])
        var set_enabled = typed(ffi.void, [ffi.bool, ffi.long])
        send_void_int(self.native, 'setSegmentCount:', value.length())

        iter var i = 0; i < value.length(); i++ {
          var segment = value[i]
          set_label(
            self.native,
            sel('setLabel:forSegment:'),
            ns_string(segment.get('label', '')),
            i,
          )
          set_enabled(
            self.native,
            sel('setEnabled:forSegment:'),
            segment.get('enabled', true) != false,
            i,
          )
          var tip = segment.get('tooltip')
          set_label(
            self.native,
            sel('setToolTip:forSegment:'),
            tip == nil ? nil : ns_string(tip),
            i,
          )
        }

        self._select()
      }
      when 'mode' {
        send_void_uint(self.native, 'setTrackingMode:', _TRACKING.get(value, 0))
        self._select()
      }
      when 'selected' {
        self._select()
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  _select() {
    var chosen = self.props.get('selected', [])
    var set_selected = typed(ffi.void, [ffi.bool, ffi.long])
    var count = send_int(self.native, 'segmentCount')

    iter var i = 0; i < count; i++ {
      set_selected(
        self.native,
        sel('setSelected:forSegment:'),
        chosen.contains(i),
        i,
      )
    }
  }

  on_action() {
    if self.props.get('mode') == 'momentary' {
      self.fire('pressed', { index: send_int(self.native, 'selectedSegment') })
      return
    }

    var chosen = []
    var is_selected = typed(ffi.bool, [ffi.long])
    var count = send_int(self.native, 'segmentCount')

    iter var i = 0; i < count; i++ {
      if is_selected(self.native, sel('isSelectedForSegment:'), i) {
        chosen.append(i)
      }
    }

    self.fire('changed', { selected: chosen })
  }
}

/**
 * A pop-up button.
 */
class MacPopup < MacView {

  @new(backend, props: dict, dispatch: function) {
    var button = typed(ffi.ptr, [CGRect, ffi.bool])(
      send(cls('NSPopUpButton'), 'alloc'),
      sel('initWithFrame:pullsDown:'),
      rect(0, 0, 100, 22),
      false,
    )
    send_void_bool(button, 'setAutoenablesItems:', false)
    _wire(button)
    self.setup(backend, 'popup', button, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'items' {
        send_void(self.native, 'removeAllItems')
        var menu = send(self.native, 'menu')
        var make = typed(ffi.ptr, [ffi.ptr, ffi.ptr, ffi.ptr])

        for item in value {
          if item.get('separator', false) {
            send_void_id(
              menu,
              'addItem:',
              send(cls('NSMenuItem'), 'separatorItem'),
            )
            continue
          }

          var entry = make(
            send(cls('NSMenuItem'), 'alloc'),
            sel('initWithTitle:action:keyEquivalent:'),
            ns_string(item.get('title', '')),
            nil,
            ns_string(''),
          )
          send_void_bool(
            entry,
            'setEnabled:',
            item.get('enabled', true) != false,
          )
          send_void_id(menu, 'addItem:', entry)
          release(entry)
        }

        self._select()
      }
      when 'selected' {
        self._select()
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
      when 'control_size' {
        send_void_uint(self.native, 'setControlSize:', control_size(value))
      }
    }
  }

  _select() {
    var index = self.props.get('selected', -1)

    if index == nil or index < 0 {
      send_void_id(self.native, 'selectItem:', nil)
    } else {
      send_void_int(self.native, 'selectItemAtIndex:', index)
    }
  }

  on_action() {
    self.fire('changed', {
      selected: send_int(self.native, 'indexOfSelectedItem'),
    })
  }
}

# NSDatePickerElementFlags.
var _DATE_ELEMENTS = { date: 0x00e0, time: 0x000e, date_time: 0x00ee }

# NSDatePickerStyle values for each DateStyle.
var _DATE_STYLES = { field: 0, compact: 2, graphical: 1 }

def _ns_date(seconds) {
  return typed(ffi.ptr, [ffi.double])(
    cls('NSDate'),
    sel('dateWithTimeIntervalSince1970:'),
    seconds,
  )
}

/**
 * A date picker.
 */
class MacDatePicker < MacView {

  @new(backend, props: dict, dispatch: function) {
    var picker = create_with_frame('NSDatePicker', nil)
    send_void_bool(picker, 'setBezeled:', true)
    _wire(picker)
    self.setup(backend, 'date_picker', picker, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        send_void_id(
          self.native,
          'setDateValue:',
          _ns_date(value == nil ? 0 : value),
        )
      }
      when 'min' {
        send_void_id(
          self.native,
          'setMinDate:',
          value == nil ? nil : _ns_date(value),
        )
      }
      when 'max' {
        send_void_id(
          self.native,
          'setMaxDate:',
          value == nil ? nil : _ns_date(value),
        )
      }
      when 'mode' {
        send_void_uint(
          self.native,
          'setDatePickerElements:',
          _DATE_ELEMENTS.get(value, 0x00e0),
        )
      }
      when 'style' {
        send_void_uint(
          self.native,
          'setDatePickerStyle:',
          _DATE_STYLES.get(value, 0),
        )
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
    }
  }

  measure(constraints: Constraints) {
    var size = send_size(self.native, 'fittingSize')

    # The fitting width of a field-style picker leaves its last digit
    # against the edge of the bezel.
    return Size(
      size.width + (self.props.get('style') == 'graphical' ? 0 : 6),
      size.height,
    )
  }

  on_action() {
    var stamp = send_double(
      send(self.native, 'dateValue'),
      'timeIntervalSince1970',
    )
    self.fire('changed', { value: stamp.round() })
  }
}

/**
 * A `Color` from an `NSColor`, read in sRGB.
 *
 * @param Pointer color
 * @returns Color
 */
def from_ns_color(color) {
  var srgb = send_id(
    color,
    'colorUsingColorSpace:',
    send(cls('NSColorSpace'), 'sRGBColorSpace'),
  )

  if srgb == nil {
    return Color.BLACK
  }

  var part = @(name) => (send_double(srgb, name) * 255).round().max(0).min(255)
  return Color(
    part('redComponent'),
    part('greenComponent'),
    part('blueComponent'),
    send_double(srgb, 'alphaComponent').max(0).min(1),
  )
}

/**
 * A colour well.
 */
class MacColorWell < MacView {

  @new(backend, props: dict, dispatch: function) {
    var well = create_with_frame('NSColorWell', rect(0, 0, 44, 24))
    _wire(well)
    self.setup(backend, 'color_well', well, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        if value != nil {
          send_void_id(self.native, 'setColor:', ns_color(value))
        }
      }
      when 'enabled' {
        send_void_bool(self.native, 'setEnabled:', value == true)
      }
    }
  }

  measure(constraints: Constraints) {
    return Size(44, 24)
  }

  on_action() {
    self.fire('changed', { value: from_ns_color(send(self.native, 'color')) })
  }
}

# NSLevelIndicatorStyle values for each LevelStyle.
var _LEVEL_STYLES = { relevancy: 0, continuous: 1, discrete: 2, rating: 3 }

/**
 * A level indicator.
 */
class MacLevel < MacView {

  @new(backend, props: dict, dispatch: function) {
    var level = create_with_frame('NSLevelIndicator', nil)
    _wire(level)
    self.setup(backend, 'level', level, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'value' {
        send_void_double(self.native, 'setDoubleValue:', value)
      }
      when 'min' {
        send_void_double(self.native, 'setMinValue:', value)
      }
      when 'max' {
        send_void_double(self.native, 'setMaxValue:', value)
      }
      when 'warning' {
        send_void_double(
          self.native,
          'setWarningValue:',
          value == nil ? self.props.get('max', 5) + 1 : value,
        )
      }
      when 'critical' {
        send_void_double(
          self.native,
          'setCriticalValue:',
          value == nil ? self.props.get('max', 5) + 1 : value,
        )
      }
      when 'style' {
        send_void_uint(
          self.native,
          'setLevelIndicatorStyle:',
          _LEVEL_STYLES.get(value, 1),
        )
      }
      when 'editable' {
        send_void_bool(self.native, 'setEditable:', value == true)
      }
    }
  }

  measure(constraints: Constraints) {
    var size = send_size(self.native, 'fittingSize')
    return Size(size.width.max(100), size.height.max(16))
  }

  on_action() {
    self.fire('changed', { value: send_double(self.native, 'doubleValue') })
  }
}

/**
 * A separator line.
 */
class MacSeparator < MacView {

  @new(backend, props: dict, dispatch: function) {
    var box = create_with_frame('NSBox', rect(0, 0, 10, 1))

    # NSBoxSeparator.
    send_void_uint(box, 'setBoxType:', 2)
    self.setup(backend, 'separator', box, props, dispatch)
  }

  measure(constraints: Constraints) {
    return Size(1, 1)
  }

  baseline() {
    return nil
  }
}

/**
 * A group box. Its content view is a flipped view of zug's, so children
 * are placed from the top left as everywhere else.
 */
class MacGroupBox < MacView {
  var content

  @new(backend, props: dict, dispatch: function) {
    var box = create_with_frame('NSBox', rect(0, 0, 200, 200))

    # NSBoxPrimary.
    send_void_uint(box, 'setBoxType:', 0)
    self.content = create_with_frame('ZugView', nil)
    send_void_id(box, 'setContentView:', self.content)
    self.setup(backend, 'group_box', box, props, dispatch)
  }

  apply(name: string, value) {
    if name == 'title' {
      send_void_id(
        self.native,
        'setTitle:',
        ns_string(value == nil ? '' : value),
      )

      # NSNoTitle 0, NSAtTop 2.
      send_void_uint(self.native, 'setTitlePosition:', value == nil ? 0 : 2)
    }
  }

  container_for(slot) {
    return self.content
  }

  content_insets(slot) {
    var frame = send_rect(self.native, 'frame')
    var probe = 200
    send_void_rect(
      self.native,
      'setFrame:',
      rect(frame.origin.x, frame.origin.y, probe, probe),
    )
    var inner = send_rect(self.content, 'frame')
    send_void_rect(self.native, 'setFrame:', frame)
    var left = inner.origin.x
    var bottom = inner.origin.y
    var right = probe - left - inner.size.width
    var top = probe - bottom - inner.size.height
    return EdgeInsets(left.max(0), top.max(0), right.max(0), bottom.max(0))
  }

  measure(constraints: Constraints) {
    var insets = self.content_insets(nil)
    return Size(insets.horizontal(), insets.vertical())
  }

  baseline() {
    return nil
  }

  before_destroy() {
    release(self.content)
  }
}

# NSImageScaling values for each ImageFit.
var _SCALING = { scale_down: 0, fill: 1, none: 2, contain: 3 }

/**
 * An image view.
 */
class MacImage < MacView {
  var image

  # The image as loaded, which `image` is, or shows turned and flipped.
  var original

  @new(backend, props: dict, dispatch: function) {
    var view = create_with_frame('NSImageView', nil)
    send_void_bool(view, 'setEditable:', false)
    self.setup(backend, 'image', view, props, dispatch)
  }

  apply(name: string, value) {
    using name {
      when 'source' {
        self._let_go()
        release(self.original)
        self.original = self._load(value)
        self._show()
      }
      when 'rotation', 'flip_horizontal', 'flip_vertical' {
        self._show()
      }
      when 'fit' {
        send_void_uint(self.native, 'setImageScaling:', _SCALING.get(value, 3))
      }
      when 'tint' {
        send_void_id(
          self.native,
          'setContentTintColor:',
          value == nil ? nil : ns_color(value),
        )
      }
    }
  }

  _load(source) {
    if source == nil {
      return nil
    }

    if source.contains('path') {
      return typed(ffi.ptr, [ffi.ptr])(
        send(cls('NSImage'), 'alloc'),
        sel('initWithContentsOfFile:'),
        ns_string(source.path),
      )
    }

    if source.contains('bytes') {
      var data = typed(ffi.ptr, [ffi.ptr, ffi.ulong])(
        cls('NSData'),
        sel('dataWithBytes:length:'),
        source.bytes,
        source.bytes.length(),
      )
      return typed(ffi.ptr, [ffi.ptr])(
        send(cls('NSImage'), 'alloc'),
        sel('initWithData:'),
        data,
      )
    }

    if source.contains('symbol') {
      var base = typed(ffi.ptr, [ffi.ptr, ffi.ptr])(
        cls('NSImage'),
        sel('imageWithSystemSymbolName:accessibilityDescription:'),
        ns_string(source.symbol),
        nil,
      )

      if base == nil {
        return nil
      }

      var weight = _symbol_weight(source.get('weight', 400))
      var config = typed(ffi.ptr, [ffi.double, ffi.double])(
        cls('NSImageSymbolConfiguration'),
        sel('configurationWithPointSize:weight:'),
        source.get('size', 13),
        weight,
      )
      return retain(send_id(base, 'imageWithSymbolConfiguration:', config))
    }

    return nil
  }

  measure(constraints: Constraints) {
    if self.image == nil {
      return Size.ZERO
    }

    var size = send_size(self.image, 'size')
    return Size(size.width, size.height)
  }

  baseline() {
    return nil
  }

  before_destroy() {
    self._let_go()
    release(self.original)
  }

  # Shows the original, turned and flipped as the props say.
  _show() {
    self._let_go()
    var rotation = self.props.get('rotation', 0)
    var across = self.props.get('flip_horizontal', false) == true
    var down = self.props.get('flip_vertical', false) == true

    if self.original == nil or (rotation == 0 and !across and !down) {
      self.image = self.original
    } else {
      self.image = self._transformed(rotation, across, down)
    }

    send_void_id(self.native, 'setImage:', self.image)
  }

  # Releases the turned copy, if one is shown.
  _let_go() {
    if self.image != nil and self.image != self.original {
      release(self.image)
    }

    self.image = nil
  }

  # The original drawn mirrored and then turned clockwise into a bitmap
  # with as many pixels as the original has, so it stays as sharp.
  _transformed(rotation: number, across: bool, down: bool) {
    var original = self.original
    var size = send_size(original, 'size')
    var quarter = rotation == 90 or rotation == 270
    var width = quarter ? size.height : size.width
    var height = quarter ? size.width : size.height

    # A vector image has no pixels of its own, so it is drawn at twice its
    # size, as on a Retina display.
    var scale = 2
    var reps = from_ns_array(send(original, 'representations'))

    if !reps.is_empty() and size.width > 0 {
      var pixels = send_int(reps[0], 'pixelsWide')

      if pixels > 0 {
        scale = pixels / size.width
      }
    }

    var rep = _bitmap(
      send(cls('NSBitmapImageRep'), 'alloc'),
      sel(
        'initWithBitmapDataPlanes:pixelsWide:pixelsHigh:bitsPerSample:samplesPerPixel:hasAlpha:isPlanar:colorSpaceName:bytesPerRow:bitsPerPixel:',
      ),
      nil,
      (width * scale).round().max(1),
      (height * scale).round().max(1),
      8,
      4,
      true,
      false,
      ffi.open().symbol('NSDeviceRGBColorSpace').read(ffi.ptr),
      0,
      0,
    )
    send_void_size(rep, 'setSize:', { width, height })

    var NSGraphicsContext = cls('NSGraphicsContext')
    send_void(NSGraphicsContext, 'saveGraphicsState')
    send_void_id(
      NSGraphicsContext,
      'setCurrentContext:',
      send_id(NSGraphicsContext, 'graphicsContextWithBitmapImageRep:', rep),
    )

    var turn = send(cls('NSAffineTransform'), 'transform')
    _two_doubles(turn, sel('translateXBy:yBy:'), width / 2, height / 2)

    # The bitmap is not flipped, so a clockwise turn is a negative one.
    _one_double(turn, sel('rotateByDegrees:'), -rotation)
    _two_doubles(turn, sel('scaleXBy:yBy:'), across ? -1 : 1, down ? -1 : 1)
    _two_doubles(
      turn,
      sel('translateXBy:yBy:'),
      -size.width / 2,
      -size.height / 2,
    )
    send_void(turn, 'concat')
    _draw_in_rect(
      original,
      sel('drawInRect:fromRect:operation:fraction:'),
      rect(0, 0, size.width, size.height),
      rect(0, 0, 0, 0),
      _SOURCE_OVER,
      1,
    )
    send_void(NSGraphicsContext, 'restoreGraphicsState')

    var image = typed(ffi.ptr, [CGSize])(
      send(cls('NSImage'), 'alloc'),
      sel('initWithSize:'),
      { width, height },
    )
    send_void_id(image, 'addRepresentation:', rep)
    release(rep)
    send_void_bool(image, 'setTemplate:', send_bool(original, 'isTemplate'))
    return image
  }
}

# NSCompositingOperationSourceOver.
var _SOURCE_OVER = 2

var _two_doubles = typed(ffi.void, [ffi.double, ffi.double])
var _one_double = typed(ffi.void, [ffi.double])
var _draw_in_rect = typed(ffi.void, [CGRect, CGRect, ffi.ulong, ffi.double])
var _bitmap = typed(ffi.ptr, [
  ffi.ptr,
  ffi.long,
  ffi.long,
  ffi.long,
  ffi.long,
  ffi.bool,
  ffi.bool,
  ffi.ptr,
  ffi.long,
  ffi.long,
])

def _symbol_weight(css: number) {
  var weights = [
    [150, -0.8],
    [250, -0.6],
    [350, -0.4],
    [450, 0],
    [550, 0.23],
    [650, 0.3],
    [750, 0.4],
    [850, 0.56],
  ]

  for pair in weights {
    if css <= pair[0] {
      return pair[1]
    }
  }

  return 0.62
}
