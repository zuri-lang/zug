/**
 * Every widget zug has, in one window, with two sets of options.
 *
 * `check_backend()` builds the gallery to check a backend: building it
 * uses every view kind, and switching to the other set of options changes
 * nearly every prop of every kind. It is also an application in its own
 * right, where every control works and a switch at the top swaps the
 * sets.
 */

import date
import math
import .. { * }

var _ROWS = [
  ['Ada Lovelace', '36', 'Analyst'], ['Charles Babbage', '79', 'Engineer'],
  ['Grace Hopper', '85', 'Admiral'],
]

/**
 * The gallery application: a window of every widget, which `changed`
 * shows with its first set of options or, when true, its second. Every
 * control keeps what the user does to it, until the set changes and puts
 * the set's values back.
 *
 * ```zuri,ignore
 * import zug { ObservableValue, run_app }
 * import zug.testing { gallery_app }
 *
 * run_app(gallery_app(ObservableValue(false)))
 * ```
 *
 * @param ObservableValue changed: holds a bool.
 * @param ?dict options: `menus` (true) to give the application a menu
 *    bar, and `second_window` (true) to open another window while the
 *    second set is shown.
 * @returns Widget
 */
def gallery_app(changed, options: ?dict) {
  var o = check_options(
    options, 'gallery_app', { menus: 'bool', second_window: 'bool' },
  )
  var menus = o.get('menus', true)
  var second_window = o.get('second_window', true)

  return Observer(changed, @(context) {
    var alt = changed.value()
    var windows = [Window(
      alt ? 'zug gallery, second set' : 'zug gallery', Gallery(changed, alt), {
        size: Size(780, 680),
        resizable: !alt,
        min_size: Size(300, 200),
      },
    )]

    if alt and second_window {
      windows.append(Window(
        'zug gallery, second window', Center(Text('A second window')), {
          size: Size(240, 120),
          on_closed: @{
            changed.set(false)
          },
        },
      ))
    }

    return App({
      title: 'zug gallery',
      menu_bar: menus ? _menu_bar(changed, alt) : nil,
      windows,
    })
  })
}

def _menu_bar(changed, alt: bool) {
  return MenuBar([Menu('Gallery', [
    MenuItem('First Set', {
      shortcut: 'cmd+1',
      checked: !alt,
      on_selected: @{
        changed.set(false)
      },
    }),
    MenuItem('Second Set', {
      shortcut: 'cmd+2',
      checked: alt,
      on_selected: @{
        changed.set(true)
      },
    }),
    MenuItem.separator(),
    MenuItem('More', { items: [MenuItem(alt ? 'Inner, second set' : 'Inner', {
      enabled: !alt,
      on_selected: @{},
    })] }),
  ])], { app_items: [MenuItem('Settings…', {
    shortcut: 'cmd+,',
    on_selected: @{},
  })] })
}

# The values the user can change, as each set starts them.
def _start_values(alt: bool) {
  return {
    check: alt,
    mixed: alt ? nil : true,
    radio: alt ? 'Two' : 'One',
    switch: alt,
    segment: alt ? 2 : 1,
    slider: alt ? 0.8 : 0.2,
    vslider: alt ? 30 : 70,
    stepper: alt ? 8 : 3,
    level: alt ? 4 : 2,
    toggle: alt,
    colour_name: alt ? 'green' : 'red',
    moment: date.from_time(alt ? 1800000000 : 1700000000),
    colour: alt ? Color.hex('#0a84ff') : Color.RED,
    field: alt ? 'second text' : 'text',
    area: alt ? 'two\nlines' : 'one line',
    search: alt ? 'query' : '',
    combo: alt ? 'x' : 'a',
    name: 'Ada',
    tab: alt ? 1 : 0,
    rows: alt ? [0, 1] : [1],
    ascending: !alt,
    taps: [],
  }
}

/**
 * The gallery's window content.
 *
 * @internal
 */
class Gallery < StatefulWidget {
  var changed
  var alt = false

  @new(changed, alt: bool) {
    self.changed = changed
    self.alt = alt
  }

  create_state() {
    return GalleryState()
  }
}

/**
 * @internal
 */
class GalleryState < State {
  var v = {}
  var last = 'Nothing yet'

  init_state() {
    self.v = _start_values(self.widget.alt)
  }

  did_update_widget(previous) {
    if previous.alt != self.widget.alt {
      self.v = _start_values(self.widget.alt)
      self.last = self.widget.alt ? 'Second set' : 'First set'
    }
  }

  # A handler that keeps the value under `name`.
  keep(name: string) {
    return @(value) {
      self.set_state(@{
        self.v[name] = value
        self.last = '${name}: ${_shown(value)}'
      })
    }
  }

  # A handler that only says what happened.
  note(what: string) {
    return @{
      self.set_state(@{
        self.last = what
      })
    }
  }

  build(context) {
    var alt = self.widget.alt
    var header = Row([
      Switch(alt, { on_changed: @(value) {
        self.widget.changed.set(value)
      } }),
      Text('Second set of options'),
      Spacer(),
      Text(self.last, {
        style: TextStyle({ color: Color.system('secondary_label') }),
        max_lines: 1,
        overflow: TextOverflow.ELLIPSIS,
      }),
    ], { spacing: 8 })

    return Column([
      Padding(EdgeInsets.symmetric({ horizontal: 12, vertical: 8 }), header),
      Separator(),
      Expanded(ScrollView(Padding(EdgeInsets.all(12), Column([
        self.text(alt), self.buttons(alt), self.choices(alt),
        self.values(alt), self.pickers(alt), self.indicators(alt),
        self.media(alt), self.inputs(alt), self.containers(alt),
        self.table(alt), self.drawing(alt), self.layout(alt),
      ], { spacing: 12, align_items: AlignItems.STRETCH })))),
    ], { align_items: AlignItems.STRETCH })
  }

  text(alt: bool) {
    return Column([
      Text(
        alt
          ? 'Text in its second set, long enough to be cut short at the end of the line'
          : 'Text',
        {
          style: TextStyle({
            size: alt ? 18 : 13,
            weight: alt ? 700 : 400,
            italic: alt,
            underline: alt,
            strikethrough: alt,
            monospaced_digits: alt,
            color: alt ? Color.system('accent') : nil,
          }),
          align: alt ? TextAlign.CENTER : TextAlign.START,
          max_lines: alt ? 1 : nil,
          overflow: alt ? TextOverflow.ELLIPSIS : TextOverflow.CLIP,
          selectable: alt,
          tooltip: alt ? 'The second tooltip' : 'A tooltip',
          accessibility_label: alt ? 'second text' : 'text',
          accessibility_identifier: 'gallery text',
        },
      ),
      Text('Design ${alt ? "rounded" : "monospaced, in Helvetica"}', {
        style: TextStyle({
          design: alt ? FontDesign.ROUNDED : FontDesign.MONOSPACED,
          family: alt ? nil : 'Helvetica',
        }),
      }),
    ], { spacing: 4, align_items: AlignItems.STRETCH })
  }

  buttons(alt: bool) {
    var buttons = []

    for variant in [
      ButtonVariant.PUSH, ButtonVariant.FLEXIBLE, ButtonVariant.SQUARE,
      ButtonVariant.TOOLBAR, ButtonVariant.INLINE, ButtonVariant.BORDERLESS,
    ] {
      buttons.append(Button(alt ? '${variant}!' : variant, {
        variant,
        on_pressed: self.note('pressed ${variant}'),
        size: alt ? ControlSize.SMALL : ControlSize.REGULAR,
      }))
    }

    buttons.append(Button('+', {
      variant: ButtonVariant.CIRCULAR,
      on_pressed: self.note('pressed +'),
    }))
    buttons.append(Button('', {
      variant: ButtonVariant.HELP,
      on_pressed: self.note('pressed help'),
    }))

    for role in [
      ButtonRole.PRIMARY, ButtonRole.CANCEL, ButtonRole.DESTRUCTIVE,
    ] {
      buttons.append(Button(
        role, { role, on_pressed: self.note('pressed ${role}') },
      ))
    }

    buttons.append(Button(alt ? 'Shortcut ⇧⌘G' : 'Shortcut ⌘G', {
      shortcut: alt ? 'cmd+shift+g' : 'cmd+g',
      tint: alt ? Color.system('green') : nil,
      on_pressed: self.note('pressed the shortcut button'),
    }))
    buttons.append(Button('Toggle', {
      selected: self.v.toggle,
      on_selected_changed: self.keep('toggle'),
    }))
    buttons.append(Button(alt ? 'Enabled' : 'Disabled', {
      enabled: alt,
      on_pressed: self.note('pressed the enabled button'),
    }))
    return Wrap(buttons, { spacing: 6, run_spacing: 6 })
  }

  choices(alt: bool) {
    return Wrap([
      Checkbox(
        self.v.check, { label: 'Checkbox', on_changed: self.keep('check') },
      ),
      Checkbox(self.v.mixed, {
        label: 'Mixed',
        tristate: true,
        on_changed: self.keep('mixed'),
      }),
      Checkbox(false, { label: 'Disabled' }),
      RadioGroup(['One', 'Two'], self.v.radio, {
        axis: alt ? Axis.HORIZONTAL : Axis.VERTICAL,
        on_changed: self.keep('radio'),
      }),
      Switch(self.v.switch, {
        on_changed: self.keep('switch'),
        size: alt ? ControlSize.SMALL : ControlSize.REGULAR,
      }),
      SegmentedControl(
        ['A', Segment('B', { tooltip: 'The second' }), 'C'], self.v.segment, {
          on_changed: self.keep('segment'),
          size: alt ? ControlSize.SMALL : ControlSize.REGULAR,
        },
      ),
      SegmentedControl(['Back', 'Forward'], nil, {
        mode: SegmentMode.MOMENTARY,
        on_pressed: @(index) {
          self.set_state(@{
            self.last = index == 0 ? 'pressed Back' : 'pressed Forward'
          })
        },
      }),
    ], { spacing: 12, run_spacing: 8 })
  }

  values(alt: bool) {
    return Row([
      Expanded(Slider(self.v.slider, {
        divisions: alt ? 4 : nil,
        on_changed: self.keep('slider'),
        on_change_end: @(value) {},
      })),
      Box({ height: 60, child: Slider(self.v.vslider, {
        min: 0,
        max: 100,
        vertical: true,
        on_changed: self.keep('vslider'),
      }) }),
      Stepper(self.v.stepper, {
        min: 0,
        max: 10,
        step: alt ? 2 : 1,
        wraps: alt,
        on_changed: self.keep('stepper'),
      }),
      Text(
        '${self.v.stepper}', { style: TextStyle({ monospaced_digits: true }) },
      ),
      LevelIndicator(self.v.level, {
        style: alt ? LevelStyle.RATING : LevelStyle.CONTINUOUS,
        warning: 3,
        critical: 4,
        on_changed: self.keep('level'),
      }),
    ], { spacing: 12 })
  }

  pickers(alt: bool) {
    return Wrap([
      Dropdown(
        [
          DropdownItem('red', 'Red'), DropdownItem.separator(),
          DropdownItem('green', 'Green'),
          DropdownItem('blue', 'Blue', { enabled: !alt }),
        ],
        self.v.colour_name, { on_changed: self.keep('colour_name') },
      ),
      DatePicker(self.v.moment, {
        mode: alt ? DateMode.DATE_TIME : DateMode.DATE,
        style: alt ? DateStyle.COMPACT : DateStyle.FIELD,
        on_changed: self.keep('moment'),
      }),
      ColorWell(self.v.colour, { on_changed: self.keep('colour') }),
    ], { spacing: 12, run_spacing: 8 })
  }

  indicators(alt: bool) {
    return Column([
      ProgressBar({ value: alt ? nil : self.v.slider }),
      ProgressBar({ value: self.v.vslider, min: 0, max: 100 }),
      Row([
        Spinner({ animating: !alt, size: alt ? 'small' : 'regular' }),
        Box({ height: 24, child: Separator({ axis: Axis.VERTICAL }) }),
        Expanded(Separator()),
      ], { spacing: 8 }),
    ], { spacing: 8, align_items: AlignItems.STRETCH })
  }

  media(alt: bool) {
    return Row([
      Image(ImageSource.symbol('star.fill', { size: alt ? 20 : 14 }), {
        width: 28,
        height: 28,
        fit: alt ? ImageFit.FILL : ImageFit.CONTAIN,
        tint: alt ? Color.system('orange') : nil,
      }),
      Icon(alt ? 'trash' : 'gearshape', {
        size: alt ? 20 : 13,
        weight: alt ? 700 : 400,
        color: alt ? Color.system('red') : nil,
      }),
      GroupBox(Text(alt ? 'Inside, second set' : 'Inside'), {
        title: alt ? 'Group, second set' : 'Group',
      }),
      VisualEffect(Padding(EdgeInsets.all(8), Text('Material')), {
        material: alt ? Material.HUD : Material.SIDEBAR,
        blending: alt ? 'within' : 'behind',
      }),
    ], { spacing: 12 })
  }

  inputs(alt: bool) {
    return Column([
      TextField({
        text: self.v.field,
        placeholder: 'A field',
        obscure: alt,
        bezel: alt ? FieldBezel.SQUARE : FieldBezel.ROUNDED,
        align: alt ? 'end' : 'start',
        style: TextStyle({ size: alt ? 15 : 13 }),
        on_changed: self.keep('field'),
        on_submitted: @(text) {
          self.set_state(@{
            self.last = 'submitted ${text}'
          })
        },
      }),
      TextField({ text: 'Read only', read_only: true }),
      Box({ height: 60, child: TextArea({
        text: self.v.area,
        wrap: !alt,
        bordered: !alt,
        on_changed: self.keep('area'),
      }) }),
      Row([
        Expanded(SearchField({
          text: self.v.search,
          placeholder: 'Search',
          size: alt ? ControlSize.SMALL : ControlSize.REGULAR,
          on_changed: self.keep('search'),
        })),
        Expanded(ComboBox(alt ? ['x', 'y'] : ['a', 'b', 'c'], {
          text: self.v.combo,
          completes: alt,
          visible_items: alt ? 3 : 8,
          on_changed: self.keep('combo'),
          on_selected: @(index, text) {},
        })),
      ], { spacing: 8 }),
    ], { spacing: 8, align_items: AlignItems.STRETCH })
  }

  containers(alt: bool) {
    return Box({ height: 130, child: Row([
      Expanded(ScrollView(Box({
        width: 400,
        height: 300,
        color: Color.system('control_background'),
        alignment: Alignment.TOP_LEFT,
        padding: EdgeInsets.all(8),
        child: Text('Scroll me'),
      }), { axis: alt ? 'both' : 'vertical', bordered: alt })),
      Expanded(ListView.builder(
        alt ? 50 : 1000, @(context, index) => Text('Row ${index}'),
        { item_extent: 20 },
      )),
      Expanded(TabView([
        Tab('One', Center(Text('First'))), Tab('Two', Center(Text('Second'))),
      ], self.v.tab, { on_changed: self.keep('tab') })),
      Expanded(SplitView([Center(Text('Left')), Center(Text('Right'))], {
        axis: alt ? Axis.VERTICAL : Axis.HORIZONTAL,
        divider: alt ? SplitDivider.THICK : SplitDivider.THIN,
        initial: [80],
        on_resize: @(sizes) {},
      })),
    ], { spacing: 8 }) })
  }

  table(alt: bool) {
    var rows = alt ? _ROWS[0, 2] : _ROWS.clone()
    var ascending = self.v.ascending
    rows.sort(@(a, b) => ascending ? a[0].compare(b[0]) : b[0].compare(a[0]))

    return Box({ height: 120, child: DataTable(
      [
        DataColumn('name', 'Name', { width: 140, sortable: true }),
        DataColumn('age', 'Age', { width: 50, align: TextAlign.END }),
        DataColumn('role', 'Role', { min_width: 60 }),
      ],
      rows.length(), @(row, column) {
        var person = rows[row]
        return column == 'name'
          ? person[0]
          : column == 'age' ? person[1] : person[2]
      }, {
        selection: alt ? Selection.MULTIPLE : Selection.SINGLE,
        selected: self.v.rows,
        sort: ['name', ascending],
        alternating: !alt,
        grid: alt,
        header: !alt,
        on_selection_changed: self.keep('rows'),
        on_activate: @(row) {
          self.set_state(@{
            self.last = 'opened ${rows[row][0]}'
          })
        },
        on_sort: @(column, up) {
          self.set_state(@{
            self.v['ascending'] = up
            self.last = up ? 'sorted A to Z' : 'sorted Z to A'
          })
        },
      },
    ) })
  }

  drawing(alt: bool) {
    var taps = self.v.taps

    return Row([
      Expanded(PointerArea(Canvas(@(painter, size) {
        _paint(painter, size, alt)

        for point in taps {
          painter.fill_oval(
            Rect(point.x - 4, point.y - 4, 8, 8), Color.system('accent'),
          )
        }
      }, { repaint: [alt, taps.length()], height: 110 }), {
        cursor: alt ? Cursor.CROSSHAIR : Cursor.POINTING_HAND,
        on_tap: @(event) {
          self.set_state(@{
            self.v.taps.append(event.position)
            self.last = 'tapped the canvas'
          })
        },
        on_double_tap: @(event) {
          self.set_state(@{
            self.v['taps'] = []
            self.last = 'cleared the canvas'
          })
        },
        on_hover: @(event) {},
        on_scroll: @(event) {},
        on_drag: @(event) {},
        menu: [MenuItem('Clear', { on_selected: @{
          self.set_state(@{
            self.v['taps'] = []
            self.last = 'cleared the canvas'
          })
        } })],
      })),
      ContextMenu(Box({
        width: 80,
        height: 40,
        color: alt ? Color.system('green') : Color.system('blue'),
        border: Border.all(alt ? 2 : 1, Color.BLACK),
        radius: alt ? 10 : 2,
        shadow: alt ? Shadow({ blur: 6, y: 3 }) : nil,
        opacity: alt ? 0.6 : 1,
        clip: alt,
        alignment: Alignment.CENTER,
        child: Text('Box'),
      }), [MenuItem(alt ? 'Second item' : 'Item', {
        on_selected: self.note('chose the box menu item'),
      })]),
    ], { spacing: 8 })
  }

  layout(alt: bool) {
    return Table([
      [
        Text('Name'),
        TextField({ text: self.v.name, on_changed: self.keep('name') }),
      ],
      [Text('Visible'), Visibility(Text('Now you see it'), {
        visible: !alt,
        keep_state: true,
      })],
    ], {
      columns: [ColumnWidth.fit(), ColumnWidth.flex()],
      align_items: AlignItems.BASELINE,
      column_spacing: 8,
      row_spacing: 6,
    })
  }
}

# A value as the status line shows it.
def _shown(value) {
  if value == nil
    or is_string(value)
    or is_number(value)
    or is_bool(value)
    or is_list(value) {
    return '${value}'
  }

  return instance_of(value, Color) ? value.to_hex() : 'a new ${typeof(value)}'
}

# Draws with every method a painter has.
def _paint(painter, size, alt: bool) {
  var line = Paint({
    color: alt ? Color.system('red') : Color.BLACK,
    width: alt ? 3 : 1,
    cap: LineCap.ROUND,
    join: LineJoin.ROUND,
  })
  var dashed = Paint({ color: Color.system('blue'), width: 1, dash: [4, 2] })
  painter.fill_rect(Rect(0, 0, size.width, size.height), Color.WHITE)
  painter.save()
  painter.translate(4, 4)
  painter.scale(1, 1)
  painter.rotate(alt ? 0.05 : 0)
  painter.clip_rect(Rect(0, 0, size.width - 8, size.height - 8))
  painter.stroke_rect(Rect(0, 0, 40, 20), line)
  painter.fill_rounded_rect(Rect(50, 0, 40, 20), 4, Color.system('orange'))
  painter.stroke_rounded_rect(Rect(100, 0, 40, 20), 4, dashed)
  painter.fill_oval(Rect(150, 0, 20, 20), Color.system('green'))
  painter.stroke_oval(Rect(180, 0, 20, 20), line)
  painter.line(Point(0, 28), Point(200, 28), line)
  var path = Path()
  path.move_to(0, 40)
  path.line_to(20, 60)
  path.quad_to(30, 40, 40, 60)
  path.cubic_to(50, 40, 60, 80, 70, 60)
  path.close()
  path.arc(Point(100, 50), 10, 0, math.PI)
  path.add_rect(Rect(120, 40, 16, 16))
  path.add_oval(Rect(140, 40, 16, 16))
  path.add_rounded_rect(Rect(160, 40, 16, 16), 4)
  painter.fill_path(path, Color.system('purple'))
  painter.stroke_path(path, line)
  var style = TextStyle({ size: alt ? 14 : 11 })
  var measured = painter.measure_text('zug', style)
  painter.text(
    'zug ${measured.width.round()}, tap to draw', Point(0, 72), style,
  )
  painter.image(ImageSource.symbol('star.fill'), Rect(150, 70, 16, 16))
  painter.restore()
}
