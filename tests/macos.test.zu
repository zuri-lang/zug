# Tests of the macOS backend against real AppKit views. They open windows
# and take keyboard focus, so they run only when ZUG_MACOS_TESTS is 1:
#
#     ZUG_MACOS_TESTS=1 zuri test macos.test.zu

import test { * }

import os
import ffi
import ..app { * }
import ..app.testing { check_backend }

var enabled = os.platform == 'macos' and os.get_env('ZUG_MACOS_TESTS') == '1'
var suite = enabled ? describe : describe_skip

var _objc = ffi.open('/usr/lib/libobjc.A.dylib')
var _sel = _objc.function('sel_registerName', ffi.ptr, [ffi.string])
var _send = _objc.function('objc_msgSend', ffi.ptr, [ffi.ptr, ffi.ptr])
var _send_void_id = _objc.function(
  'objc_msgSend', ffi.void, [ffi.ptr, ffi.ptr, ffi.ptr],
)
var _send_long = _objc.function('objc_msgSend', ffi.long, [ffi.ptr, ffi.ptr])
var _utf8 = _objc.function('objc_msgSend', ffi.string, [ffi.ptr, ffi.ptr])
var _class = _objc.function('objc_getClass', ffi.ptr, [ffi.string])
var _send_long_arg = _objc.function(
  'objc_msgSend', ffi.ptr, [ffi.ptr, ffi.ptr, ffi.long],
)
var _send_string_arg = _objc.function(
  'objc_msgSend', ffi.ptr, [ffi.ptr, ffi.ptr, ffi.string],
)
var _select_rows = _objc.function(
  'objc_msgSend', ffi.void, [ffi.ptr, ffi.ptr, ffi.ptr, ffi.bool],
)

# Selects one row of a native table as a click does.
def select_row(table, row) {
  var indexes = _send_long_arg(
    _class('NSIndexSet'), _sel('indexSetWithIndex:'), row,
  )
  _select_rows(
    table, _sel('selectRowIndexes:byExtendingSelection:'), indexes, false,
  )
}

# Types `text` into a native text view at its cursor.
def type_into(text_view, text) {
  var string = _send_string_arg(
    _class('NSString'), _sel('stringWithUTF8String:'), text,
  )
  _send_void_id(text_view, _sel('insertText:'), string)
}

var _Point = ffi.struct('KeyPoint').add_field('x', ffi.double).add_field(
  'y', ffi.double,
)
var _key_event = _objc.function('objc_msgSend', ffi.ptr, [
  ffi.ptr, ffi.ptr, ffi.ulong, _Point, ffi.ulong, ffi.double, ffi.long, ffi.ptr,
  ffi.ptr, ffi.ptr, ffi.bool, ffi.ushort,
])
var _send_bool_id = _objc.function(
  'objc_msgSend', ffi.bool, [ffi.ptr, ffi.ptr, ffi.ptr],
)
var _Bounds = ffi
  .struct('KeyBounds')
  .add_field('x', ffi.double)
  .add_field('y', ffi.double)
  .add_field('w', ffi.double)
  .add_field('h', ffi.double)
var _bounds = _objc.function('objc_msgSend', _Bounds, [ffi.ptr, ffi.ptr])
var _convert = _objc.function(
  'objc_msgSend', _Point, [ffi.ptr, ffi.ptr, _Point, ffi.ptr],
)
var _mouse_event = _objc.function('objc_msgSend', ffi.ptr, [
  ffi.ptr, ffi.ptr, ffi.ulong, _Point, ffi.ulong, ffi.double, ffi.long, ffi.ptr,
  ffi.long, ffi.long, ffi.float,
])
var _post_event = _objc.function(
  'objc_msgSend', ffi.void, [ffi.ptr, ffi.ptr, ffi.ptr, ffi.bool],
)

# Clicks the middle of a native view with the mouse. The button goes up
# from the event queue, where the view's tracking looks for it.
def mouse_click(view) {
  var window = _send(view, _sel('window'))
  var b = _bounds(view, _sel('bounds'))
  var at = _convert(
    view, _sel('convertPoint:toView:'),
    { x: b.x + b.w / 2, y: b.y + b.h / 2 }, nil,
  )
  var number = _send_long(window, _sel('windowNumber'))
  var make = @(type, pressure) => _mouse_event(
    _class('NSEvent'),
    _sel('mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:'),
    type, at, 0, 0, number, nil, 0, 1, pressure,
  )
  _post_event(
    _send(_class('NSApplication'), _sel('sharedApplication')),
    _sel('postEvent:atStart:'), make(2, 0.0), false,
  )
  _send_void_id(window, _sel('sendEvent:'), make(1, 1.0))
}

# Sends a native window a key going down, as the keyboard does. It goes
# to the window itself rather than through the application, which drops
# keys while another application is active.
def _key_down(window, characters, code) {
  var string = _send_string_arg(
    _class('NSString'), _sel('stringWithUTF8String:'), characters,
  )
  return _key_event(
    _class('NSEvent'),
    _sel('keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:'),
    10, { x: 0, y: 0 }, 0, 0, _send_long(window, _sel('windowNumber')), nil,
    string, string, false, code,
  )
}

def send_key(window, characters, code) {
  _send_void_id(window, _sel('sendEvent:'), _key_down(window, characters, code))
}

# The button in a native view, or the views inside it, whose key
# equivalent is `characters`, or nil.
def button_for_key(view, characters) {
  if _send_bool_id(view, _sel('isKindOfClass:'), _class('NSButton'))
    and native_string(view, 'keyEquivalent') == characters {
    return view
  }

  var subviews = _send(view, _sel('subviews'))

  iter var i = 0; i < _send_long(subviews, _sel('count')); i++ {
    var found = button_for_key(
      _send_long_arg(subviews, _sel('objectAtIndex:'), i), characters,
    )

    if found != nil {
      return found
    }
  }

  return nil
}

# Offers a key to the buttons of a native window whose shortcut it is, as
# AppKit does for the key window. AppKit offers them only there, and the
# test application need not be active while someone uses the machine.
def press_key_equivalent(window, characters, code) {
  return _send_bool_id(
    window, _sel('performKeyEquivalent:'), _key_down(window, characters, code),
  )
}

def native_string(object, name) {
  return _utf8(_send(object, _sel(name)), _sel('UTF8String'))
}

def click(native) {
  _send_void_id(native, _sel('performClick:'), nil)
}

# The views of `kind` in the running application, in tree order.
def hosts(runtime, kind) {
  var found = []
  runtime.root.render_object.visit(@(node) {
    if node.is_host() and node.kind == kind {
      found.append(node)
    }
  })
  return found
}

# What zug reported while the last run_steps() ran, as
# `context: message` lines. An error in an AppKit callback is reported
# rather than raised, so a test must look here to see it.
var reported = []

# Runs `widget` as an application, calls each step in turn on a timer
# with the runtime, and quits after the last. Returns the backend.
def run_steps(widget, steps: list) {
  var backend = create_backend('macos')
  var runtime = Runtime(backend)
  var at = 0.5
  reported.clear()
  set_error_handler(@(error, context) {
    reported.append('${context}: ${error.message}')
  })

  for step in steps {
    var fn = step
    backend.start_timer(at, false, @{
      fn(runtime)
    })
    at += 0.3
  }

  backend.start_timer(at, false, @{
    runtime.quit()
  })

  catch {
    runtime.run(widget)
  } as error {
    set_error_handler(nil)
    raise error
  }

  set_error_handler(nil)
  return backend
}

class Probe < StatefulWidget {
  create_state() {
    return ProbeState()
  }
}

class ProbeState < State {
  var count = 0

  build(context) {
    return Padding(EdgeInsets.all(10), Column([
      Text('count ${self.count}'),
      Button('Press', { on_pressed: @{
        self.set_state(@{
          self.count++
        })
      } }),
      Checkbox(false, { label: 'Never', on_changed: @(value) {} }),
      Box({ width: 50, height: 20, color: Color.RED }),
    ], { spacing: 8, align_items: AlignItems.START }))
  }
}

class Editor < StatefulWidget {
  create_state() {
    return EditorState()
  }
}

# The selections the editor's table reported, and its notes.
var editor_selections = []
var editor_notes = TextController('one')

class EditorState < State {
  var selected = [0]

  build(context) {
    return Column([
      Expanded(DataTable(
        [DataColumn('name', 'Name')], 4, @(row, column) => 'row ${row}', {
          selected: self.selected,
          on_selection_changed: @(rows) {
            editor_selections.append(rows)
            self.set_state(@{
              self.selected = rows
            })
          },
        },
      )),
      Expanded(TextArea({ controller: editor_notes })),
    ])
  }
}

suite('the macOS backend', @{
  it(
    'creates native views, routes their actions, and undoes refused changes', @{
      var seen = {}

      var backend = run_steps(
        App({
          title: 'Probe',
          windows: [Window('Probe', Probe(), { size: Size(300, 200) })],
        }),
        [
          @(runtime) {
            var window = runtime.windows()[0]
            seen['visible'] = _objc.function(
              'objc_msgSend', ffi.bool, [ffi.ptr, ffi.ptr],
            )(window.view.native, _sel('isVisible'))
            seen['content'] = window.view.content_size()
            var button = hosts(runtime, 'button')[0]
            seen['title'] = native_string(button.view.native, 'title')
            seen['button_frame'] = button.view.native == nil ? nil : button.size
            click(button.view.native)
          },
          @(runtime) {
            seen['text'] = native_string(
              hosts(runtime, 'text')[0].view.native, 'stringValue',
            )
            click(hosts(runtime, 'checkbox')[0].view.native)
          },
          @(runtime) {
            seen['checkbox_state'] = _send_long(
              hosts(runtime, 'checkbox')[0].view.native, _sel('state'),
            )
            seen['live'] = runtime.backend.live_objects()
          },
        ],
      )

      expect(reported).to_be_empty()
      expect(seen.visible).to_be_true()
      expect(seen.content).to_equal(Size(300, 200))
      expect(seen.title).to_be('Press')
      expect(seen.text).to_be('count 1')
      expect(seen.checkbox_state).to_be(0)
      expect(seen.live > 0).to_be_true()
      expect(backend.live_objects()).to_be(0)
    },
  )

  it('lays native views out where zug placed them', @{
    var frames = []
    var _frame_type = ffi
      .struct('R')
      .add_field('x', ffi.double)
      .add_field('y', ffi.double)
      .add_field('w', ffi.double)
      .add_field('h', ffi.double)
    var native_frame = _objc.function(
      'objc_msgSend', _frame_type, [ffi.ptr, ffi.ptr],
    )

    run_steps(App({ windows: [Window('Layout', Padding(EdgeInsets.all(20), Row([
      Box({ width: 40, height: 30, color: Color.RED }),
      Expanded(Box({ height: 30, color: Color.BLUE })),
    ], {
      spacing: 10,
      align_items: AlignItems.START,
    })), { size: Size(200, 100) })] }), [
      @(runtime) {
        for host in hosts(runtime, 'box') {
          var frame = native_frame(host.view.native, _sel('frame'))
          frames.append(Rect(frame.x, frame.y, frame.w, frame.h))
        }
      },
    ])

    expect(reported).to_be_empty()
    expect(frames).to_equal([Rect(20, 20, 40, 30), Rect(70, 20, 110, 30)])
  })

  it('keeps what the user selects and types once the application accepts it', @{
    var seen = {}

    run_steps(
      App({ windows: [Window('Editor', Editor(), { size: Size(300, 300) })] }),
      [
        @(runtime) {
          select_row(hosts(runtime, 'table')[0].view.table, 2)
          type_into(hosts(runtime, 'text_area')[0].view.text_view, ' two')
        },
        @(runtime) {
          var table = hosts(runtime, 'table')[0].view.table
          seen['row'] = _send_long(table, _sel('selectedRow'))
          seen['text'] = native_string(
            hosts(runtime, 'text_area')[0].view.text_view, 'string',
          )
        },
      ],
    )

    expect(reported).to_be_empty()
    expect(editor_selections).to_equal([[2]])
    expect(seen.row).to_be(2)
    expect(editor_notes.text()).to_be('one two')
    expect(seen.text).to_be('one two')
  })

  it('passes keys that focused read-only text has no use for to the window', @{
    var keys = []
    var seen = {}

    run_steps(App({ windows: [Window('Keys', KeyListener(Column([
      Text('42', { selectable: true }),
    ]), { on_key: @(event) {
      keys.append(event.key)
      return true
    } }), { size: Size(200, 100) })] }), [
      @(runtime) {
        mouse_click(hosts(runtime, 'text')[0].view.native)
      },
      @(runtime) {
        var window = runtime.windows()[0].view.native
        seen['text_focused'] = _send_bool_id(
          _send(window, _sel('firstResponder')), _sel('isKindOfClass:'),
          _class('NSTextView'),
        )
        send_key(window, '7', 26)
        send_key(window, '', 123)
        send_key(window, '\r', 36)
      },
    ])

    expect(reported).to_be_empty()
    expect(seen.text_focused).to_be_true()
    expect(keys).to_equal(['7', 'enter'])
  })

  it('keeps focus away once a field submitted with Return takes it', @{
    var submitted = []
    var seen = {}

    run_steps(App({ windows: [Window('Submit', Builder(@(context) => Column([
      TextField({ on_submitted: @(text) {
        submitted.append(text)
        clear_focus(context)
      } }),
    ])), { size: Size(200, 100) })] }), [
      @(runtime) {
        mouse_click(hosts(runtime, 'text_field')[0].view.native)
      },
      @(runtime) {
        var window = runtime.windows()[0].view.native
        send_key(window, '4', 21)
        send_key(window, '\r', 36)
      },
      @(runtime) {
        var window = runtime.windows()[0].view.native
        seen['focused'] = _send_bool_id(
          _send(window, _sel('firstResponder')), _sel('isKindOfClass:'),
          _class('NSTextView'),
        )
      },
    ])

    expect(reported).to_be_empty()
    expect(submitted).to_equal(['4'])
    expect(seen.focused).to_be_false()
  })

  it('gives Escape to the focused view before a Cancel button takes it', @{
    var pressed = []
    var escape = @(name) => @{
      pressed.append(name)
    }

    run_steps(App({ windows: [Window('Escape', Column([
      TextField({ on_escape: escape('field') }),
      Expanded(DataTable(
        [DataColumn('name', 'Name')], 3, @(row, column) => 'row ${row}',
        { on_escape: escape('table') },
      )),
      Button('Cancel', {
        role: ButtonRole.CANCEL,
        on_pressed: escape('cancel'),
      }),
    ]), { size: Size(240, 200) })] }), [
      @(runtime) {
        mouse_click(hosts(runtime, 'text_field')[0].view.native)
      },
      @(runtime) {
        send_key(runtime.windows()[0].view.native, '\u001b', 53)
        mouse_click(hosts(runtime, 'table')[0].view.table)
      },
      @(runtime) {
        var window = runtime.windows()[0].view.native
        send_key(window, '\u001b', 53)
        runtime.windows()[0].view.clear_focus()
        press_key_equivalent(window, '\u001b', 53)
      },
    ])

    expect(reported).to_be_empty()
    expect(pressed).to_equal(['field', 'table', 'cancel'])
  })

  it('reports font and colour picks, and the last when the panel closes', @{
    var seen = { font_changes: 0 }
    var target = nil
    var manager = _send(_class('NSFontManager'), _sel('sharedFontManager'))
    var font_panel = @{
      return _objc.function(
        'objc_msgSend', ffi.ptr, [ffi.ptr, ffi.ptr, ffi.bool],
      )(manager, _sel('fontPanel:'), false)
    }
    var color_panel = _send(_class('NSColorPanel'), _sel('sharedColorPanel'))
    var visible = _objc.function('objc_msgSend', ffi.bool, [ffi.ptr, ffi.ptr])

    run_steps(App({ windows: [Window('Pick', Text('x'))] }), [
      @(runtime) {
        pick_font(nil, {
          style: TextStyle({ family: 'Helvetica', size: 13 }),
          on_changed: @(style) {
            seen['font_changes']++
          },
        }).then(@(style) {
          seen['font'] = style
        })
      },
      @(runtime) {
        seen['font_shown'] = visible(font_panel(), _sel('isVisible'))
        target = _send(manager, _sel('target'))

        # Adds bold as the Font menu's Bold item does, which the panel's
        # target converts the font with.
        var bold = _send(
          _send(_class('NSMenuItem'), _sel('alloc')), _sel('init'),
        )
        _objc.function(
          'objc_msgSend', ffi.void, [ffi.ptr, ffi.ptr, ffi.long],
        )(bold, _sel('setTag:'), 2)
        _send_void_id(manager, _sel('addFontTrait:'), bold)
        _send_void_id(font_panel(), _sel('close'), nil)
      },
      @(runtime) {
        pick_color(nil, { color: Color.RED }).then(@(color) {
          seen['color'] = color
        })
      },
      @(runtime) {
        seen['color_shown'] = visible(color_panel, _sel('isVisible'))
        _send_void_id(
          color_panel, _sel('setColor:'),
          _send(_class('NSColor'), _sel('blueColor')),
        )
        _send_void_id(target, _sel('zugColorChanged:'), color_panel)
        _send_void_id(color_panel, _sel('close'), nil)
      },
    ])

    expect(reported).to_be_empty()
    expect(seen.font_shown).to_be_true()
    expect(seen.font_changes).to_be(1)
    expect(seen.font.family).to_be('Helvetica')
    expect(seen.font.weight).to_be(700)
    expect(seen.font.size).to_be(13)
    expect(seen.color_shown).to_be_true()
    expect(seen.color).to_equal(Color(0, 0, 255))
  })

  it('shows a dialog as a sheet, and closes it from its buttons', @{
    var seen = {}
    var results = []
    var asked = 0

    # The second time, a focused field in the dialog has Escape first.
    var ask = @(context) {
      asked++
      var field = asked == 2
        ? TextField({ autofocus: true })
        : Text('Rename the file?')
      show_dialog(context, @(close) => Padding(EdgeInsets.all(20), Column([
        field,
        Row([
          Button('Cancel', {
            role: ButtonRole.CANCEL,
            on_pressed: @{
              close('cancelled')
            },
          }),
          Button('Rename', {
            role: ButtonRole.PRIMARY,
            on_pressed: @{
              close('renamed')
            },
          }),
        ], { spacing: 8 }),
      ], { spacing: 12 }))).then(@(result) {
        results.append(result)
      })
    }

    run_steps(App({ windows: [Window('Main', Builder(@(context) => Button(
      'Ask', { on_pressed: @{
        ask(context)
      } },
    )), { size: Size(320, 200) })] }), [
      @(runtime) {
        click(hosts(runtime, 'button')[0].view.native)
      },
      # A sheet slides in over a few frames.
      @(runtime) {},
      @(runtime) {
        var main = runtime.windows()[0].view.native
        var sheet = _send(main, _sel('attachedSheet'))
        seen['sheet'] = sheet != nil
          and sheet == runtime.windows()[1].view.native
        # AppKit presses the button whose key equivalent is Return only
        # while the application is active, which the test application need
        # not be while someone uses the machine. So this clicks the button
        # Return would press.
        click(button_for_key(_send(sheet, _sel('contentView')), '\r'))
      },
      @(runtime) {
        var main = runtime.windows()[0].view.native
        seen['after_return'] = _send(main, _sel('attachedSheet')) == nil
        click(hosts(runtime, 'button')[0].view.native)
      },
      @(runtime) {
        var sheet = _send(
          runtime.windows()[0].view.native, _sel('attachedSheet'),
        )
        seen['field_focused'] = _send_bool_id(
          _send(sheet, _sel('firstResponder')), _sel('isKindOfClass:'),
          _class('NSTextView'),
        )
        send_key(sheet, '\u001b', 53)
      },
      @(runtime) {
        seen['after_escape'] = _send(
          runtime.windows()[0].view.native, _sel('attachedSheet'),
        ) == nil
      },
    ])

    expect(reported).to_be_empty()
    expect(seen.sheet).to_be_true()
    expect(seen.after_return).to_be_true()
    expect(seen.field_focused).to_be_true()
    expect(seen.after_escape).to_be_true()
    expect(results).to_equal(['renamed', 'cancelled'])
  })

  it('writes pages to a PDF, laid out for the printable size', @{
    var seen = {}
    var path = os.join_paths(os.create_temp_dir('zug-print-'), 'pages.pdf')
    var style = TextStyle({ size: 12 })
    var lines = []

    iter var i = 0; i < 40; i++ {
      lines.append(
        'Line ${i} of a text that wraps across the printable width of the '
          + 'page, and goes on long enough to need a second line there.',
      )
    }

    # Which lines go on each page, and where.
    var lay_out = @(painter) {
      var width = painter.size().width
      var pages = [[]]
      var y = 0

      for line in lines {
        var height = painter.measure_text(line, style, width).height

        if y + height > painter.size().height {
          pages.append([])
          y = 0
        }

        pages[-1].append([line, y])
        y += height
      }

      return pages
    }

    run_steps(App({ windows: [Window('Print', Text('x'))] }), [
      @(runtime) {
        seen['printable'] = default_page_setup().printable_size()
        save_pdf(path, {
          title: 'Lines',
          pages: @(painter) {
            seen['measured'] = painter.size()
            seen['pages'] = lay_out(painter).length()
            return seen.pages
          },
          paint: @(painter, page) {
            for item in lay_out(painter)[page] {
              painter.text(
                item[0], Point(0, item[1]), style, painter.size().width,
              )
            }
          },
        })
      },
    ])

    ffi.open('/System/Library/Frameworks/PDFKit.framework/PDFKit')
    var send_id = _objc.function(
      'objc_msgSend', ffi.ptr, [ffi.ptr, ffi.ptr, ffi.ptr],
    )
    var url = send_id(
      _class('NSURL'), _sel('fileURLWithPath:'),
      _send_string_arg(_class('NSString'), _sel('stringWithUTF8String:'), path),
    )
    var pdf = send_id(
      _send(_class('PDFDocument'), _sel('alloc')), _sel('initWithURL:'), url,
    )
    var text = native_string(pdf, 'string')

    expect(reported).to_be_empty()
    expect(seen.measured).to_equal(seen.printable)
    expect(seen.pages > 1).to_be_true()
    expect(_send_long(pdf, _sel('pageCount'))).to_be(seen.pages)
    expect(text.contains('Line 0 of a text')).to_be_true()
    expect(text.contains('Line 39 of a text')).to_be_true()
  })

  it('shows the page setup and print panels as sheets', @{
    var results = []
    var sheets = []
    var end_sheet = @(runtime) {
      var main = runtime.windows()[0].view.native
      var sheet = _send(main, _sel('attachedSheet'))
      sheets.append(sheet != nil)

      # Cancels it, as its Cancel button does.
      _objc.function(
        'objc_msgSend', ffi.void, [ffi.ptr, ffi.ptr, ffi.ptr, ffi.long],
      )(main, _sel('endSheet:returnCode:'), sheet, 0)
    }
    var inside = nil

    run_steps(App({ windows: [Window('Print', Builder(@(context) {
      inside = context
      return Text('x')
    }), { size: Size(400, 300) })] }), [
      @(runtime) {
        page_setup(inside).then(@(setup) {
          results.append(setup)
        })
      },
      @(runtime) {},
      end_sheet,
      @(runtime) {
        print_pages(inside, { paint: @(painter, page) {} }).then(@(printed) {
          results.append(printed)
        })
      },
      @(runtime) {},
      end_sheet,
      @(runtime) {},
    ])

    expect(reported).to_be_empty()
    expect(sheets).to_equal([true, true])
    expect(results).to_equal([nil, false])
  })

  it('keeps the backend contract', @{
    var report = check_backend(create_backend('macos'))
    expect(report
      .failures()
      .map(@(result) => '${result.name}: ${result.detail}')).to_be_empty()
  })
})
