import test { * }

import ..app { * }
import ..app.backends.headless { HeadlessBackend }
import ..app.testing { check_backend, gallery_app, WidgetTester }

def check(backend) {
  return check_backend(backend, {
    advance: @(seconds) => backend.advance(seconds),
  })
}

def failed_names(report) {
  return report.failures().map(@(result) => result.name)
}

# A headless backend with faults a real one could have.
class FaultyBackend < HeadlessBackend {
  frame_interval() {
    return 0
  }

  capabilities() {
    return ['clipboard', 'telepathy']
  }

  measure_text(text: string, style: dict, max_width: ?number) {
    return Size(10, 10)
  }

  supports_kind(kind: string) {
    return kind != 'level' and parent.supports_kind(kind)
  }

  read_clipboard() {
    return 'stale'
  }
}

# A headless backend that cannot make sliders, though it says it can.
class BrokenBackend < HeadlessBackend {
  create_view(kind: string, props: dict, dispatch: function) {
    if kind == 'slider' {
      raise ValueError('no sliders here')
    }

    return parent.create_view(kind, props, dispatch)
  }
}

describe('check_backend', @{
  it('passes the headless backend, the reference', @{
    var report = check(HeadlessBackend())
    expect(failed_names(report)).to_be_empty()
    expect(report.count('passed')).to_be_greater_than(100)
    expect(report.summary())
        .to_match('/^headless: \\d+ passed, 0 failed, 2 skipped$/')
  })

  it('finds what a faulty backend gets wrong', @{
    var report = check(FaultyBackend())
    var failed = failed_names(report)
    expect(failed).to_contain('lists only capabilities zug knows')
    expect(failed).to_contain('says how often the display refreshes')
    expect(failed).to_contain('measures text')
    expect(failed).to_contain('keeps text on the clipboard')
    expect(failed).to_contain('supports every view kind')
    expect(report.passed()).to_be_false()

    var kinds = report.failures().filter(
      @(result) => result.name == 'supports every view kind',
    )
    expect(kinds[0].detail).to_be('missing level')
  })

  it('reports the errors a widget raises while the gallery is built', @{
    var report = check(BrokenBackend())
    var built = report.failures().filter(
      @(result) => result.name == 'builds every widget',
    )
    expect(built).to_have_length(1)
    expect(built[0].detail).to_contain('ValueError: no sliders here')
  })

  it('keeps what the user does in the gallery until the set changes', @{
    var changed = ObservableValue(false)
    var t = WidgetTester().pump_app(gallery_app(changed))
    var reported = []
    set_error_handler(@(error, context) {
      reported.append('${context}: ${error.message}')
    })

    var box = t.find_kind('checkbox')[0]
    box.fire('changed', { value: true })
    t.pump()
    expect(t.find_kind('checkbox')[0].props.value).to_be_true()
    expect(t.find_text('check: true')).to_have_length(1)

    var field = t.find_kind('text_field')[0]
    field.fire('changed', { text: 'typed' })
    t.pump()
    expect(t.find_kind('text_field')[0].props.text).to_be('typed')

    t.tap('push')
    expect(t.find_text('pressed push')).to_have_length(1)

    changed.set(true)
    t.pump()
    expect(t.find_kind('checkbox')[0].props.value).to_be_true()
    expect(t.find_kind('text_field')[0].props.text).to_be('second text')
    expect(t.backend.windows.filter(@(window) => !window.closed))
        .to_have_length(2)

    changed.set(false)
    t.pump()
    expect(t.find_kind('checkbox')[0].props.value).to_be_false()
    expect(t.find_kind('text_field')[0].props.text).to_be('text')

    set_error_handler(nil)
    expect(reported).to_be_empty()
    t.dispose()
  })

  it('opens each dialog from the gallery and says what it answered', @{
    var t = WidgetTester().pump_app(gallery_app(ObservableValue(false)))
    var reported = []
    set_error_handler(@(error, context) {
      reported.append('${context}: ${error.message}')
    })

    t.tap('Alert…')
    t.backend.answer_dialog({ button: 1, suppressed: false })
    t.pump()
    expect(t.find_text('alert: {button: 1, suppressed: false}'))
        .to_have_length(1)

    t.tap('Save…')
    expect(t.backend.dialogs[0].spec.name).to_be('first.txt')
    t.backend.answer_dialog('/tmp/first.txt')
    t.pump()
    expect(t.find_text('saved: /tmp/first.txt')).to_have_length(1)

    t.tap('Colour…')
    t.backend.answer_dialog(nil)
    t.pump()
    expect(t.find_text('colour chosen: nil')).to_have_length(1)

    t.tap('Page Setup…')
    t.backend.answer_dialog(
      PageSetup({ orientation: PageOrientation.LANDSCAPE, paper_name: 'A4' }),
    )
    t.pump()
    expect(t.find_text('page setup: A4, landscape')).to_have_length(1)

    t.tap('Print…')
    t.backend.answer_dialog(true)
    t.pump()
    expect(t.find_text('printed: true')).to_have_length(1)
    expect(t.backend.printed[0].pages.length()).to_be(2)

    t.tap('Sheet…')
    t.pump()
    t.tap('OK')
    t.pump()
    expect(t.find_text('sheet: confirmed')).to_have_length(1)

    set_error_handler(nil)
    expect(reported).to_be_empty()
    t.dispose()
  })

  it('can leave out the gallery', @{
    var backend = HeadlessBackend()
    var report = check_backend(backend, {
      gallery: false,
      advance: @(seconds) => backend.advance(seconds),
    })
    expect(report.passed()).to_be_true()
    expect(
      report.results.filter(@(result) => result.name == 'builds every widget'),
    ).to_be_empty()
  })
})
